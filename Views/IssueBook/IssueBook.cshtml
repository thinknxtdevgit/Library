
@{
    ViewData["Title"] = "Issue Book";
}

<div id="issueSection">

    <h2>Issue Book</h2>

    <div style="width:600px">

        <!-- ID -->
        <label>ID No</label>
        <input type="text" id="txtIdNo" class="form-control" />
        <br />

        <!-- USER DETAILS -->
        <label>Name</label>
        <input type="text" id="txtName" class="form-control" readonly />

        <label>College Name</label>
        <input type="text" id="txtCollege" class="form-control" readonly />

        <label>Course / Designation</label>
        <input type="text" id="txtCourse" class="form-control" readonly />

        <label>Batch</label>
        <input type="text" id="txtBatch" class="form-control" readonly />

        <label>Type</label>
        <input type="text" id="txtType" class="form-control" readonly />

        <label>Issue Date</label>
        <input type="text" id="txtIssueDate" class="form-control" readonly />

        <label>Last Return Date</label>
        <input type="text" id="txtReturnDate" class="form-control" readonly />

        <hr />

        <!-- BOOK -->
        <label>Accession No</label>
        <input type="text" id="txtAccession" class="form-control" />

        <label>Title</label>
        <input type="text" id="txtTitle" class="form-control" readonly />

        <label>Author</label>
        <input type="text" id="txtAuthor" class="form-control" readonly />

        <label>Category</label>
        <input type="text" id="txtCategory" class="form-control" readonly />

        <hr />

        <!-- SIGNATURE -->
        <label>Signature</label>
        <input type="password" id="txtSignature" class="form-control" />

        <br />

        <!-- PREVIOUS -->
        <h4>Previous Issue</h4>

        <label id="lblTotalBooks" style="font-weight:bold; color:black;">
            Already Book Issued - 0
        </label>

        <table border="1" width="150%" id="tblPrevious" class="table table-bordered">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Accession</th>
                    <th>Issue Date</th>
                    <th>Return Date</th>
                    <th>ID No</th>
                    <th>Author</th>
                    <th>Course</th>
                </tr>
            </thead>

            <tbody></tbody>
        </table>

        <br />

        <button class="btn btn-success" onclick="issueBook()">
            Issue Book
        </button>

        <button class="btn btn-warning" onclick="openReturnPage()">
            Return Book
        </button>

        <button class="btn btn-danger" onclick="openRenewPage()">
            Renew Book
        </button>

    </div>

</div>

<script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

<script>

    // =========================
    // LOAD STUDENT / STAFF DETAIL
    // =========================
    $("#txtIdNo").blur(function () {

    let id = $("#txtIdNo").val().trim();

    if (id == "") {
    return;
    }

    $.ajax({

    url: "/api/Login/checkid",
    type: "POST",
    contentType: "application/json",

    data: JSON.stringify({
    txtidno: id
    }),

    success: function (res) {

    console.log("ID RESPONSE =", res);

    if (!res.data || res.data.success == false) {

    alert(res.data.message);
    return;
    }

    let d = res.data.data;

    // USER DETAIL
    $("#txtName").val(d.name);
    $("#txtCollege").val(d.collegeName);
    $("#txtCourse").val(d.course || d.designation);
    $("#txtBatch").val(d.batch || d.department);
    $("#txtType").val(d.type);
    $("#txtReturnDate").val(d.lastReturnDate);

    let today = new Date().toLocaleDateString('en-GB');

    $("#txtIssueDate").val(today);

    // TOTAL BOOK
    $("#lblTotalBooks").text(
    "Already Book Issued - " + res.data.previousIssue.total
    );

    // PREVIOUS ISSUE TABLE
    let rows = "";

    res.data.previousIssue.data.forEach(function (x) {

    rows += `
    <tr>
    <td>${x.title}</td>
    <td>${x.accessionNo}</td>
    <td>${x.issueDate}</td>
    <td>${x.lastReturnDate}</td>
    <td>${x.idNo}</td>
    <td>${x.author}</td>
    <td>${x.coures}</td>
    </tr>
    `;
    });

    $("#tblPrevious tbody").html(rows);
    },

    error: function (err) {

    console.log(err);
    alert("ID Detail Load Error");
    }
    });

    });


    // =========================
    // LOAD BOOK DETAIL
    // =========================
    $("#txtAccession").blur(function () {

    let id = $("#txtIdNo").val().trim();
    let acc = $("#txtAccession").val().trim();

    if (acc == "") {
    return;
    }

    $.ajax({

    url: "/api/Login/checkid",
    type: "POST",
    contentType: "application/json",

    data: JSON.stringify({
    txtidno: id,
    txtaccessionno: acc
    }),

    success: function (res) {

    console.log("BOOK RESPONSE =", res);

    let b = res.bookDetail;

    if (!b || b.success == false) {

    alert("Book not found");
    return;
    }

    $("#txtTitle").val(b.title);
    $("#txtAuthor").val(b.author);
    $("#txtCategory").val(b.category);
    },

    error: function (err) {

    console.log(err);
    alert("Book Detail Error");
    }
    });

    });


    // =========================
    // ISSUE BOOK
    // =========================
    function issueBook() {

    let data = {

    txtidno: $("#txtIdNo").val().trim(),
    txtaccessionno: $("#txtAccession").val().trim(),
    signature: $("#txtSignature").val().trim()
    };

    $.ajax({

    url: "/api/Login/checkid",
    type: "POST",
    contentType: "application/json",

    data: JSON.stringify(data),

    success: function (res) {

    console.log("ISSUE RESPONSE =", res);

    if (!res.data || res.data.success == false) {

    alert(res.data.message);
    return;
    }

    alert("Book Issued Successfully");

    location.reload();
    },

    error: function (err) {

    console.log(err);
    alert("Issue Book Error");
    }
    });
    }


    // =========================
    // OPEN PAGES
    // =========================
    function openReturnPage() {

    window.location.href = "/ReceiveBook";
    }

    function openRenewPage() {

    window.location.href = "/RenewBook";
    }

</script>