@{
    ViewData["Title"] = "Person Transaction History";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fade-in">
    <!-- Page Header -->
    <div class="page-header mt-2 mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-user-clock me-2 text-primary"></i>Person Transaction History</h2>
            <p class="text-muted">Search and view the complete transaction history of a library member by their ID and College.</p>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="modern-card glass shadow-lg p-4" style="border-top: 4px solid var(--primary);">
                <form id="searchForm" novalidate onsubmit="event.preventDefault(); loadPersonHistory();">
                    <div class="row align-items-end g-3">
                        <div class="col-md-5">
                            <label for="collegeName" class="form-label small fw-bold text-muted mb-2">College Filter</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 input-group-text-modern">
                                    <i class="fas fa-university text-muted"></i>
                                </span>
                                <select id="collegeName" class="form-input-modern border-start-0" style="border-top-left-radius: 0; border-bottom-left-radius: 0;" required>
                                    <option value="">-- Select College --</option>
                                </select>
                                <div class="invalid-feedback">Please select a college.</div>
                            </div>
                        </div>
                        <div class="col-md-5">
                            <label for="personId" class="form-label small fw-bold text-muted mb-2">Person ID</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 input-group-text-modern">
                                    <i class="fas fa-id-card text-muted"></i>
                                </span>
                                <input type="text" id="personId" class="form-input-modern border-start-0" placeholder="Enter Person ID..." style="border-top-left-radius: 0; border-bottom-left-radius: 0;" required />
                                <div class="invalid-feedback">Please enter a Person ID.</div>
                            </div>
                        </div>
                        <div class="col-md-2">
                            <button type="submit" id="btnSearch" class="btn btn-modern btn-primary-modern w-100" style="height: 48px;">
                                <i class="fas fa-search me-2" id="searchIcon"></i>
                                <span class="spinner-border spinner-border-sm me-2 d-none" id="searchSpinner" role="status" aria-hidden="true"></span>
                                Search
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Stats Summary Row (Initially Hidden) -->
    <div class="row g-3 mb-4 d-none" id="statsRow">
        <div class="col-6 col-lg-3">
            <div class="modern-card text-center p-3 h-100" style="border-top: 4px solid var(--primary);">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="fas fa-history"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.75rem;">Total Transaction</p>
                <h3 class="fw-bold text-primary mb-0" id="statTotal">0</h3>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="modern-card text-center p-3 h-100" style="border-top: 4px solid var(--success);">
                <div class="bg-success bg-opacity-10 text-success rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="fas fa-sign-out-alt"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.75rem;">Issues</p>
                <h3 class="fw-bold text-success mb-0" id="statIssues">0</h3>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="modern-card text-center p-3 h-100" style="border-top: 4px solid var(--warning);">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="fas fa-sign-in-alt"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.75rem;">Returns</p>
                <h3 class="fw-bold text-warning mb-0" id="statReturns">0</h3>
            </div>
        </div>
        <div class="col-6 col-lg-3">
            <div class="modern-card text-center p-3 h-100" style="border-top: 4px solid var(--info);">
                <div class="bg-info bg-opacity-10 text-info rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="fas fa-sync-alt"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.75rem;">Renewals</p>
                <h3 class="fw-bold text-info mb-0" id="statRenewals">0</h3>
            </div>
        </div>
    </div>

    <!-- Results Section -->
    <div class="row">
        <div class="col-12">
            <div class="modern-card shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-main" id="resultsTitle">Transaction History</h5>
                    <span class="badge bg-primary px-3 py-2" id="rowCount">0 Records</span>
                </div>

                <!-- Desktop/Tablet Table View -->
                <div class="table-responsive-modern d-none d-md-block" id="desktopView">
                    <table class="table custom-table mb-0">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Time</th>
                                <th>Transaction</th>
                                <th>Type</th>
                                <th>Accession No</th>
                                <th>Title</th>
                                <th>ID No</th>
                                <th>Person Name</th>
                                <th>Person Type</th>
                                <th>Renewal Date</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            <tr>
                                <td colspan="10" class="text-center py-5 text-muted">
                                    <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                                    <p class="mb-0">Enter search criteria to load transaction history.</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="d-block d-md-none" id="mobileView">
                    <div id="mobileCardsContainer">
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                            <p class="mb-0">Enter search criteria to load transaction history.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            await loadColleges();
        });

        // Load colleges list
        async function loadColleges() {
            try {
                const response = await fetch('/api/report/colleges');
                if (!response.ok) throw new Error("Failed to load colleges");

                const colleges = await response.json();
                const ddl = document.getElementById("collegeName");
                ddl.innerHTML = '<option value="">-- Select College --</option>';

                colleges.forEach(college => {
                    const option = document.createElement("option");
                    option.value = college;
                    option.textContent = college;
                    ddl.appendChild(option);
                });
            } catch (error) {
                console.error(error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Unable to load colleges dropdown list.'
                });
            }
        }

        // Search loading spinner control
        function setLoading(isLoading) {
            const btnSearch = document.getElementById("btnSearch");
            const searchIcon = document.getElementById("searchIcon");
            const searchSpinner = document.getElementById("searchSpinner");

            if (isLoading) {
                btnSearch.disabled = true;
                searchIcon.classList.add("d-none");
                searchSpinner.classList.remove("d-none");
            } else {
                btnSearch.disabled = false;
                searchIcon.classList.remove("d-none");
                searchSpinner.classList.add("d-none");
            }
        }

        // Format Date Helper
        function formatDate(dateStr) {
            if (!dateStr) return "-";
            try {
                const date = new Date(dateStr);
                if (isNaN(date.getTime())) return dateStr;
                
                const yyyy = date.getFullYear();
                const mm = String(date.getMonth() + 1).padStart(2, '0');
                const dd = String(date.getDate()).padStart(2, '0');
                return `${yyyy}/${mm}/${dd}`;
            } catch {
                return dateStr;
            }
        }

        // Transaction style mappings
        function getTransactionBorderColor(txnName) {
            const name = (txnName || "").toLowerCase();
            if (name.includes("issue")) return "var(--success)";
            if (name.includes("return")) return "var(--warning)";
            if (name.includes("renew")) return "var(--info)";
            return "var(--primary)";
        }

        function getTransactionBadgeClass(txnName) {
            const name = (txnName || "").toLowerCase();
            if (name.includes("issue")) return "bg-success text-white";
            if (name.includes("return")) return "bg-warning text-dark";
            if (name.includes("renew")) return "bg-info text-white";
            return "bg-secondary text-white";
        }

        // Fetch person history
        async function loadPersonHistory() {
            const collegeName = document.getElementById("collegeName").value;
            const personId = document.getElementById("personId").value.trim();

            const form = document.getElementById("searchForm");
            if (!collegeName || !personId) {
                form.classList.add("was-validated");
                Swal.fire({
                    icon: 'warning',
                    title: 'Missing Fields',
                    text: 'Please select a College and enter a Person ID.'
                });
                return;
            }

            form.classList.remove("was-validated");
            setLoading(true);

            try {
                const response = await fetch(`/SearchPersonId/search?collegeName=${encodeURIComponent(collegeName)}&personId=${encodeURIComponent(personId)}`);
                
                if (!response.ok) {
                    const errorText = await response.text();
                    try {
                        const errorJson = JSON.parse(errorText);
                        throw new Error(errorJson.message || "Error searching person history");
                    } catch {
                        throw new Error(errorText || "Error searching person history");
                    }
                }

                const result = await response.json();

                if (!result.success) {
                    Swal.fire({
                        icon: 'info',
                        title: 'No Records Found',
                        text: result.message || 'No transaction history found for this Person ID.'
                    });
                    clearResults();
                    return;
                }

                const transactions = result.data || [];

                // Render UI Components
                renderStats(transactions);
                renderTable(transactions);
                renderMobileCards(transactions);
                
                // Toggle display sections
                document.getElementById("statsRow").classList.remove("d-none");
                document.getElementById("rowCount").innerText = `${transactions.length} Records`;
                document.getElementById("resultsTitle").innerText = `Transaction History for ID: ${personId}`;

            } catch (error) {
                console.error(error);
                Swal.fire({
                    icon: 'error',
                    title: 'Search Failed',
                    text: error.message || 'An error occurred while fetching transaction history.'
                });
                clearResults();
            } finally {
                setLoading(false);
            }
        }

        // Clear views on empty/no result
        function clearResults() {
            document.getElementById("statsRow").classList.add("d-none");
            document.getElementById("rowCount").innerText = "0 Records";
            document.getElementById("resultsTitle").innerText = "Transaction History";

            // Reset Desktop Table
            document.getElementById("tableBody").innerHTML = `
                <tr>
                    <td colspan="10" class="text-center py-5 text-muted">
                        <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                        <p class="mb-0">No records found.</p>
                    </td>
                </tr>
            `;

            // Reset Mobile Cards
            document.getElementById("mobileCardsContainer").innerHTML = `
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                    <p class="mb-0">No records found.</p>
                </div>
            `;
        }

        // Calculate and render stats
        function renderStats(transactions) {
            const total = transactions.length;
            const issues = transactions.filter(t => (t.transactionName || "").toLowerCase().includes("issue")).length;
            const returns = transactions.filter(t => (t.transactionName || "").toLowerCase().includes("return")).length;
            const renewals = transactions.filter(t => (t.transactionName || "").toLowerCase().includes("renew")).length;

            document.getElementById("statTotal").innerText = total;
            document.getElementById("statIssues").innerText = issues;
            document.getElementById("statReturns").innerText = returns;
            document.getElementById("statRenewals").innerText = renewals;
        }

        // Render Desktop Table
        function renderTable(transactions) {
            const tbody = document.getElementById("tableBody");
            tbody.innerHTML = "";

            if (transactions.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="10" class="text-center py-5">No Records Found</td>
                    </tr>
                `;
                return;
            }

            transactions.forEach(t => {
                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td class="fw-semibold">${t.transactionDate || '-'}</td>
                    <td>${t.transactionTime || '-'}</td>
                    <td>
                        <span class="badge ${getTransactionBadgeClass(t.transactionName)}">
                            ${t.transactionName || '-'}
                        </span>
                    </td>
                    <td><span class="small text-muted">${t.type || '-'}</span></td>
                    <td class="fw-semibold text-primary">${t.accessionNo || '-'}</td>
                    <td style="max-width: 200px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;" title="${t.title || ''}">${t.title || '-'}</td>
                    <td class="fw-semibold text-primary">${t.idNo || '-'}</td>
                    <td>${t.personName || '-'}</td>
                    <td><span class="small text-muted">${t.personType || '-'}</span></td>
                    <td>${formatDate(t.renewalDate)}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Render Mobile Cards
        function renderMobileCards(transactions) {
            const container = document.getElementById("mobileCardsContainer");
            container.innerHTML = "";

            if (transactions.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-5 text-muted">
                        No Records Found
                    </div>
                `;
                return;
            }

            transactions.forEach(t => {
                const card = document.createElement("div");
                card.className = "modern-card mb-3 p-3 shadow-sm border-start border-4";
                card.style.borderLeftColor = getTransactionBorderColor(t.transactionName);
                card.style.position = "relative";
                
                card.innerHTML = `
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <span class="badge ${getTransactionBadgeClass(t.transactionName)} px-2.5 py-1">
                            ${t.transactionName || '-'}
                        </span>
                        <div class="text-end">
                            <div class="text-muted" style="font-size: 0.75rem;">
                                <i class="far fa-calendar-alt me-1"></i>${t.transactionDate || ''}
                            </div>
                            <div class="text-muted" style="font-size: 0.7rem;">
                                <i class="far fa-clock me-1"></i>${t.transactionTime || ''}
                            </div>
                        </div>
                    </div>
                    
                    <h6 class="fw-bold mb-1 text-main" style="line-height: 1.3;">${t.title || '-'}</h6>
                    
                    <div class="row g-2 pt-2 border-top mt-2 text-muted" style="font-size: 0.825rem;">
                        <div class="col-6">
                            <span class="text-muted small d-block">Accession No</span>
                            <span class="fw-bold text-primary">${t.accessionNo || '-'}</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block">Type</span>
                            <span class="fw-semibold">${t.type || '-'}</span>
                        </div>
                        <div class="col-6 mt-1">
                            <span class="text-muted small d-block">ID No</span>
                            <span class="fw-semibold text-main">${t.idNo || '-'}</span>
                        </div>
                        <div class="col-6 mt-1">
                            <span class="text-muted small d-block">Person Name</span>
                            <span class="fw-semibold text-main">${t.personName || '-'}</span>
                            <span class="badge bg-light text-dark border small ms-1" style="font-size: 0.65rem;">${t.personType || '-'}</span>
                        </div>
                        ${t.renewalDate ? `
                        <div class="col-12 mt-1 text-primary">
                            <span class="text-muted small d-block">Renewal Date</span>
                            <span class="fw-semibold"><i class="fas fa-sync me-1"></i>${formatDate(t.renewalDate)}</span>
                        </div>` : ''}
                    </div>
                `;
                container.appendChild(card);
            });
        }
    </script>
}
