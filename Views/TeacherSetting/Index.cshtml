@{
    ViewData["Title"] = "Teacher Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fade-in">
    <!-- Page Header -->
    <div class="page-header mt-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="fas fa-chalkboard-teacher text-primary me-2"></i>Teacher & Staff Profiles
            </h2>
            <p class="text-muted">Manage teacher and staff profile records, edit designation details, contact information, and export registers.</p>
        </div>
        <div class="d-flex gap-2 w-100-mobile">
            <button class="btn btn-modern btn-secondary-modern btn-auto-width" id="btnExport" disabled style="background: linear-gradient(135deg, var(--success) 0%, #15803d 100%); color: white; box-shadow: 0 4px 14px rgba(34, 197, 94, 0.3);">
                <i class="fas fa-file-excel me-2"></i> Export Excel
            </button>
            <button class="btn btn-modern btn-primary-modern btn-auto-width text-white" id="btnAdd" disabled>
                <i class="fas fa-plus me-2"></i> Add Teacher
            </button>
        </div>
    </div>

    <!-- Filters Panel -->
    <div class="modern-card mb-4 glass border-0">
        <div class="row g-3 align-items-end">
            <!-- College Selector -->
            <div class="col-lg-9 col-md-8">
                <label class="form-label small fw-bold text-muted mb-2">College / Institution</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-top-left-radius: var(--radius-md); border-bottom-left-radius: var(--radius-md); border-color: var(--border-color);">
                        <i class="fas fa-university text-muted"></i>
                    </span>
                    <select id="ddlCollege" class="form-input-modern" style="border-top-left-radius:0; border-bottom-left-radius:0;">
                        <option value="">-- Loading Colleges... --</option>
                    </select>
                </div>
            </div>

            <!-- Apply Filter Button -->
            <div class="col-lg-3 col-md-4">
                <button class="btn btn-modern btn-primary-modern w-100 py-2 text-white" id="btnSearch" disabled>
                    <i class="fas fa-search me-2"></i> Apply Filter
                </button>
            </div>
        </div>
    </div>

    <!-- Results Display Panel -->
    <div class="row">
        <div class="col-12">
            <div class="modern-card shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-main" id="resultsTitle">Teachers Directory</h5>
                    <span class="badge badge-modern badge-modern-primary" id="recordCountDisplay">0 Records Found</span>
                </div>

                <!-- Desktop/Tablet Table View -->
                <div class="table-responsive-modern d-none d-md-block" id="desktopView">
                    <table class="table custom-table mb-0" id="resultsTable">
                       @*  <thead>
                            <tr>
                                <th class="ps-4">ID No</th>
                                <th>Name</th>
                                <th>Designation</th>
                                <th>Father Name</th>
                                <th>Permanent Address</th>
                                <th>Mobile No</th>
                                <th>Contact No</th>
                                <th>Email</th>
                                <th class="pe-4 text-center">Actions</th>
                            </tr>
                        </thead> *@
                        <thead>
                            <tr>
                                <th class="text-center fw-bold" style="width:8%;">ID No</th>
                                <th class="text-center fw-bold" style="width:15%;">Name</th>
                                <th class="text-center fw-bold" style="width:15%;">Designation</th>
                                <th class="text-center fw-bold" style="width:15%;">Father Name</th>
                                <th class="text-center fw-bold" style="width:20%;">Permanent Address</th>
                                <th class="text-center fw-bold" style="width:10%;">Mobile No</th>
                                <th class="text-center fw-bold" style="width:10%;">Contact No</th>
                                <th class="text-center fw-bold" style="width:15%;">Email</th>
                                <th class="text-center fw-bold" style="width:12%;">Actions</th>
                            </tr>
                        </thead>
                    
                        <tbody id="tableBody">
                            <tr>
                                <td colspan="8" class="text-center py-5 text-muted">
                                    <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                                    <p class="mb-0">Select college filters and click Apply Filter to display teacher records.</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="d-block d-md-none" id="mobileView">
                    <div id="mobileCardsContainer">
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                            <p class="mb-0">Select college filters and click Apply Filter to display teacher records.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Teacher Modal -->
<div class="modal fade" id="teacherModal" tabindex="-1" aria-labelledby="teacherModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: var(--bg-card); color: var(--text-main); border: 1px solid var(--border-color); border-radius: var(--radius-lg);">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                <h5 class="modal-title fw-bold" id="teacherModalLabel">Add Teacher Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: var(--theme-close-btn-filter, invert(0.5)); outline: none; box-shadow: none;"></button>
            </div>
            <div class="modal-body p-4">
                <form id="teacherForm" autocomplete="off">
                    <input type="hidden" id="hdnOldID" value="" />
                    
                    <div class="row g-3">
                        <!-- ID No & Name -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Staff ID No <span class="text-danger">*</span></label>
                            <input type="number" id="txtIDNo" class="form-input-modern" required placeholder="Unique numerical ID" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Teacher/Staff Name <span class="text-danger">*</span></label>
                            <input type="text" id="txtName" class="form-input-modern" required placeholder="Full Name" />
                        </div>

                        <!-- Designation & Department/Father's Name -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Designation</label>
                            <input type="text" id="txtDesignation" class="form-input-modern" placeholder="e.g. Assistant Professor" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Father's Name</label>
                            <input type="text" id="txtFatherName" class="form-input-modern" placeholder="Father's Full Name" />
                        </div>

                        <!-- Contact Details -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Email Address</label>
                            <input type="email" id="txtEMailID" class="form-input-modern" placeholder="teacher@domain.com" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-muted">Contact No (Phone)</label>
                            <input type="text" id="txtContactNo" class="form-input-modern" placeholder="Landline or Alternate" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-muted">Mobile No</label>
                            <input type="text" id="txtMobileNo" class="form-input-modern" placeholder="10-digit mobile" />
                        </div>

                        <!-- Permanent Address -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Permanent Address</label>
                            <textarea id="txtPermanentAddress" class="form-input-modern" rows="2" placeholder="Full permanent address details..."></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-modern btn-secondary-modern" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-modern btn-primary-modern text-white" id="btnSaveTeacher">
                    <i class="fas fa-save me-2"></i> Save Profile
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let teachersList = [];

        $(document).ready(async function () {
            await loadColleges();

            // College selector change listener
            $('#ddlCollege').change(function () {
                const college = getSelectedCollege();
                if (!college) {
                    $('#btnSearch').prop('disabled', true);
                    $('#btnAdd').prop('disabled', true);
                    $('#btnExport').prop('disabled', true);
                    return;
                }
                $('#btnSearch').prop('disabled', false);
                $('#btnAdd').prop('disabled', false);
            });

            // Apply filter
            $('#btnSearch').click(async function () {
                await loadTeachers();
            });

            // Export Excel
            $('#btnExport').click(function () {
                const college = getSelectedCollege();
                if (college) {
                    window.location.href = `/TeacherSetting/ExportExcel?collegeName=${encodeURIComponent(college)}`;
                }
            });

            // Add Teacher Trigger
            $('#btnAdd').click(function () {
                openModalForAdd();
            });

            // Save Action
            $('#btnSaveTeacher').click(async function () {
                await saveTeacherProfile();
            });
        });

        // ================= GET SELECTIONS =================
        function getSelectedCollege() {
            return $('#ddlCollege').val();
        }

        // ================= DYNAMIC COLLEGE LOAD =================
        async function loadColleges() {
            try {
                const response = await fetch('/api/report/colleges');
                if (!response.ok) throw new Error("Failed to fetch colleges");
                
                const colleges = await response.json();
                const $ddl = $('#ddlCollege');
                $ddl.empty();

                if (colleges.length === 0) {
                    $ddl.append('<option value="">-- No Colleges Authorized --</option>');
                    return;
                }

                $ddl.append('<option value="">-- Select College --</option>');
                colleges.forEach(c => {
                    $ddl.append(`<option value="${c}">${c}</option>`);
                });

                // Auto-select if there is exactly 1 authorized college
                if (colleges.length === 1) {
                    $ddl.val(colleges[0]).trigger('change');
                }
            } catch (err) {
                console.error("Colleges loading failed:", err);
                Swal.fire({
                    icon: 'error',
                    title: 'Retrieval Failed',
                    text: 'Failed to retrieve college profiles list from server.'
                });
            }
        }

        // ================= GET TEACHERS LIST =================
        async function loadTeachers() {
            const college = getSelectedCollege();
            if (!college) return;

            showLoader();
            try {
                const response = await $.ajax({
                    url: '/TeacherSetting/GetTeachers',
                    type: 'GET',
                    data: { collegeName: college }
                });

                Swal.close();
                teachersList = response || [];
                renderTeachers();
            } catch (err) {
                Swal.close();
                console.error("Failed to load teachers:", err);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to retrieve teacher records from server.'
                });
                teachersList = [];
                renderTeachers();
            }
        }

        // ================= RENDER TABLE & CARDS =================
        function renderTeachers() {
            const $tbody = $('#tableBody');
            const $mobileContainer = $('#mobileCardsContainer');

            $tbody.empty();
            $mobileContainer.empty();

            const count = teachersList.length;
            $('#recordCountDisplay').text(`${count} Records Found`);

            if (count === 0) {
                $tbody.append(`
                    <tr>
                        <td colspan="8" class="text-center py-5 text-muted">
                            <div class="py-4">
                                <i class="fas fa-user-minus fa-2x mb-3 text-muted"></i>
                                <p class="mb-0 fw-semibold">No teacher records found in this institution.</p>
                            </div>
                        </td>
                    </tr>
                `);
                
                $mobileContainer.append(`
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-user-minus fa-2x mb-3 text-muted"></i>
                        <p class="mb-0">No teacher records found in this institution.</p>
                    </div>
                `);

                $('#btnExport').prop('disabled', true);
                return;
            }

            teachersList.forEach(teacher => {
                // Desktop row markup
                $tbody.append(`
                    <tr>
                        <td class="ps-4 fw-medium text-primary">${teacher.idNo || '-'}</td>
                        <td class="fw-semibold text-main">${teacher.name || '-'}</td>
                        <td class="fw-semibold text-primary">${teacher.designation || '-'}</td>
                        <td>${teacher.fatherName || '-'}</td>
                        <td class="small text-wrap text-muted" style="max-width: 200px;">${teacher.permanentAddress || '-'}</td>
                        <td><i class="fas fa-mobile-alt me-1 text-muted"></i>${teacher.mobileNo || '-'}</td>
                        <td><i class="fas fa-phone me-1 text-muted"></i>${teacher.contactNo || '-'}</td>
                        <td class="small">${teacher.eMailID || '-'}</td>
                        <td class="pe-4 text-center">
                            <button class="btn btn-sm btn-outline-primary" style="border-radius:var(--radius-sm);" onclick="openModalForEdit(${teacher.idNo})">
                                <i class="fas fa-pen"></i> Edit
                            </button>
                        </td>
                    </tr>
                `);

                // Mobile card markup
                $mobileContainer.append(`
                    <div class="card mb-3 shadow-sm border-0" style="background: var(--bg-main); border-radius: var(--radius-md); border: 1px solid var(--border-color) !important;">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                                <span class="badge bg-primary-subtle text-primary fw-bold">ID: ${teacher.idNo}</span>
                                <span class="small text-muted fw-bold text-uppercase" style="font-size:0.75rem;">${teacher.designation || '-'}</span>
                            </div>
                            <h6 class="fw-bold mb-1 text-main">${teacher.name || '-'}</h6>
                            <p class="text-muted small mb-2"><i class="fas fa-envelope me-1"></i> ${teacher.eMailID || '-'}</p>
                            <div class="small text-muted mb-2">
                                <i class="fas fa-map-marker-alt me-1"></i> ${teacher.permanentAddress || '-'}
                            </div>
                            <div class="d-flex justify-content-between pt-2 border-top small">
                                <span><i class="fas fa-mobile-alt me-1"></i> ${teacher.mobileNo || '-'}</span>
                                <span class="text-primary cursor-pointer" onclick="openModalForEdit(${teacher.idNo})">
                                    <i class="fas fa-pen me-1"></i> Edit Profile
                                </span>
                            </div>
                        </div>
                    </div>
                `);
            });

            $('#btnExport').prop('disabled', false);
        }

        // ================= MODAL STATE MANAGEMENT =================
        function openModalForAdd() {
            $('#teacherModalLabel').text('Add Teacher Profile');
            $('#teacherForm')[0].reset();
            $('#hdnOldID').val('');
            
            // Enable primary key IDNo input for new additions
            $('#txtIDNo').prop('readonly', false);
            
            $('#teacherModal').modal('show');
        }

        function openModalForEdit(idNo) {
            const teacher = teachersList.find(t => t.idNo === idNo);
            if (!teacher) return;

            $('#teacherModalLabel').text('Edit Teacher Profile');
            $('#hdnOldID').val(teacher.idNo);
            
            // Populate fields
            $('#txtIDNo').val(teacher.idNo).prop('readonly', true); // Keep read-only during edit for data safety
            $('#txtName').val(teacher.name);
            $('#txtDesignation').val(teacher.designation);
            $('#txtFatherName').val(teacher.fatherName);
            $('#txtPermanentAddress').val(teacher.permanentAddress);
            $('#txtContactNo').val(teacher.contactNo);
            $('#txtMobileNo').val(teacher.mobileNo);
            $('#txtEMailID').val(teacher.eMailID);

            $('#teacherModal').modal('show');
        }

        // ================= SAVE / UPDATE DATA =================
        async function saveTeacherProfile() {
            const idNo = $('#txtIDNo').val();
            const name = $('#txtName').val().trim();

            if (!idNo || !name) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Required Fields',
                    text: 'Staff ID No and Name are required.'
                });
                return;
            }

            const oldId = $('#hdnOldID').val();
            const isEdit = oldId !== '';

            // Construct teacher setting data DTO
            const dto = {
                CollegeName: getSelectedCollege(),
                IDNo: parseInt(idNo),
                Name: name,
                Designation: $('#txtDesignation').val().trim(),
                FatherName: $('#txtFatherName').val().trim(),
                PermanentAddress: $('#txtPermanentAddress').val().trim(),
                ContactNo: $('#txtContactNo').val().trim(),
                MobileNo: $('#txtMobileNo').val().trim(),
                EMailID: $('#txtEMailID').val().trim()
            };

            showLoader();
            try {
                const url = isEdit ? `/TeacherSetting/UpdateTeacher/${oldId}` : '/TeacherSetting/AddTeacher';
                const method = isEdit ? 'PUT' : 'POST';

                // NOTE: TeacherSettingController explicitly specifies [FromBody], so we submit as JSON
                const response = await $.ajax({
                    url: url,
                    type: method,
                    contentType: 'application/json',
                    data: JSON.stringify(dto)
                });

                Swal.close();

                // C# action returns bool (result)
                if (response === true) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Saved Successfully',
                        text: 'Teacher profile details have been saved.'
                    });
                    $('#teacherModal').modal('hide');
                    await loadTeachers();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Operation Failed',
                        text: 'A record with this ID No may already exist, or save failed.'
                    });
                }
            } catch (err) {
                Swal.close();
                console.error("Save teacher error:", err);
                Swal.fire({
                    icon: 'error',
                    title: 'Request Failed',
                    text: 'An error occurred on the server while saving details.'
                });
            }
        }

        // ================= DYNAMIC SPINNER =================
        function showLoader() {
            Swal.fire({
                title: 'Processing Request...',
                text: 'Please Wait',
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
        }
    </script>
}
