@{
    Layout = null;
}

@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Login - LibMaster Pro</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@400;500;600;700;800&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
        :root {
            --primary: #3b82f6;
            --primary-dark: #2563eb;
            --bg-gradient: linear-gradient(135deg, #f8fafc 0%, #e2e8f0 100%);
            --card-bg: #ffffff;
            --text-dark: #0f172a;
            --text-muted: #64748b;
            --border-color: #cbd5e1;
            --focus-ring: rgba(59, 130, 246, 0.2);
        }

        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Plus Jakarta Sans', sans-serif;
            background: var(--bg-gradient);
            color: var(--text-dark);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }

        .login-wrapper {
            width: 100%;
            max-width: 1000px;
            background: var(--card-bg);
            border-radius: 24px;
            box-shadow: 0 20px 40px -15px rgba(15, 23, 42, 0.08), 0 0 1px 1px rgba(15, 23, 42, 0.04);
            display: flex;
            overflow: hidden;
            min-height: 580px;
        }

        /* Left Hero Banner */
        .login-hero {
            flex: 1;
            background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);
            color: #ffffff;
            padding: 45px 40px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            position: relative;
            overflow: hidden;
        }

        .login-hero::before {
            content: '';
            position: absolute;
            top: -80px;
            right: -80px;
            width: 260px;
            height: 260px;
            background: radial-gradient(circle, rgba(59, 130, 246, 0.3) 0%, transparent 70%);
            border-radius: 50%;
            pointer-events: none;
        }

        .hero-brand {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .hero-logo {
            width: 44px;
            height: 44px;
            background: linear-gradient(135deg, #3b82f6, #6366f1);
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.25rem;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.4);
        }

        .hero-title {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 1.4rem;
            letter-spacing: -0.02em;
        }

        .hero-content h1 {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 2.2rem;
            line-height: 1.25;
            margin-bottom: 16px;
            color: #ffffff;
        }

        .hero-content h1 span {
            color: #60a5fa;
        }

        .hero-content p {
            color: #94a3b8;
            font-size: 0.925rem;
            line-height: 1.6;
        }

        .hero-features {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .feature-item {
            display: flex;
            align-items: center;
            gap: 12px;
            background: rgba(255, 255, 255, 0.05);
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 10px 14px;
            border-radius: 12px;
            font-size: 0.85rem;
            color: #cbd5e1;
        }

        .feature-item i {
            color: #38bdf8;
        }

        /* Right Form Area */
        .login-form-container {
            flex: 1;
            padding: 45px 40px;
            display: flex;
            flex-direction: column;
            justify-content: center;
            background: #ffffff;
        }

        .form-title {
            font-family: 'Outfit', sans-serif;
            font-weight: 700;
            font-size: 1.8rem;
            color: var(--text-dark);
            margin-bottom: 6px;
        }

        .form-subtitle {
            color: var(--text-muted);
            font-size: 0.875rem;
            margin-bottom: 28px;
        }

        .form-group-custom {
            margin-bottom: 20px;
        }

        .form-group-custom label {
            display: block;
            font-size: 0.8rem;
            font-weight: 700;
            color: var(--text-dark);
            margin-bottom: 6px;
            letter-spacing: 0.02em;
        }

        .input-box {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-box i.input-icon {
            position: absolute;
            left: 14px;
            color: #94a3b8;
            font-size: 0.95rem;
            pointer-events: none;
            transition: color 0.2s ease;
        }

        .input-field {
            width: 100%;
            height: 48px;
            padding: 10px 14px 10px 42px;
            border: 1px solid var(--border-color);
            border-radius: 12px;
            font-size: 0.925rem;
            color: var(--text-dark);
            background: #f8fafc;
            outline: none;
            transition: all 0.2s ease;
        }

        .input-field:focus {
            background: #ffffff;
            border-color: var(--primary);
            box-shadow: 0 0 0 4px var(--focus-ring);
        }

        .input-field:focus ~ i.input-icon {
            color: var(--primary);
        }

        select.input-field {
            appearance: none;
            -webkit-appearance: none;
            cursor: pointer;
            padding-right: 40px;
        }

        select.input-field option {
            background: #ffffff !important;
            color: var(--text-dark) !important;
        }

        .select-arrow {
            position: absolute;
            right: 14px;
            color: #94a3b8;
            pointer-events: none;
            font-size: 0.8rem;
        }

        .btn-eye {
            position: absolute;
            right: 12px;
            background: none;
            border: none;
            color: #94a3b8;
            padding: 6px;
            cursor: pointer;
            font-size: 0.9rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .btn-eye:hover {
            color: var(--text-dark);
        }

        .form-meta {
            display: flex;
            align-items: center;
            justify-content: space-between;
            margin-bottom: 24px;
            font-size: 0.85rem;
        }

        .checkbox-label {
            display: flex;
            align-items: center;
            gap: 8px;
            cursor: pointer;
            color: var(--text-muted);
            user-select: none;
        }

        .checkbox-label input {
            accent-color: var(--primary);
            width: 16px;
            height: 16px;
            border-radius: 4px;
        }

        .link-forgot {
            color: var(--primary);
            text-decoration: none;
            font-weight: 600;
        }

        .link-forgot:hover {
            text-decoration: underline;
        }

        .btn-submit {
            width: 100%;
            height: 48px;
            background: linear-gradient(135deg, var(--primary), var(--primary-dark));
            color: #ffffff;
            border: none;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.95rem;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            cursor: pointer;
            box-shadow: 0 4px 12px rgba(59, 130, 246, 0.3);
            transition: all 0.2s ease;
        }

        .btn-submit:hover {
            transform: translateY(-1px);
            box-shadow: 0 6px 16px rgba(59, 130, 246, 0.4);
        }

        .form-footer {
            margin-top: 24px;
            text-align: center;
            font-size: 0.8rem;
            color: var(--text-muted);
        }

        /* RESPONSIVE DESIGN */
        @@media (max-width: 991px) {
            body {
                padding: 15px;
            }
            .login-hero {
                display: none !important;
            }
            .login-wrapper {
                max-width: 450px;
                min-height: auto;
                border-radius: 20px;
            }
            .login-form-container {
                padding: 35px 25px;
            }
        }

        @@media (max-width: 480px) {
            .login-form-container {
                padding: 28px 18px;
            }
            .form-title {
                font-size: 1.6rem;
            }
            .form-meta {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }
        }
    </style>
</head>
<body>

    <div class="login-wrapper">
        <!-- Hero Section (Desktop Left) -->
        <div class="login-hero">
            <div class="hero-brand">
                <div class="hero-logo">
                    <i class="fas fa-book-reader"></i>
                </div>
                <div class="hero-title">LibMaster Pro</div>
            </div>

            <div class="hero-content">
                <h1>Smart Library <br /><span>Management System</span></h1>
                <p>Streamline book issuances, catalog records, member registries, and automated circulation reporting.</p>
            </div>

            <div class="hero-features">
                <div class="feature-item">
                    <i class="fas fa-check-circle"></i>
                    <span>Real-time Book Accession Tracking</span>
                </div>
                <div class="feature-item">
                    <i class="fas fa-shield-alt"></i>
                    <span>Role-Based Access Control</span>
                </div>
                <div class="feature-item">
                    <i class="fas fa-chart-line"></i>
                    <span>Automated Circulation Reports</span>
                </div>
            </div>
        </div>

        <!-- Form Section (Right) -->
        <div class="login-form-container">
            <div class="form-title">Welcome Back</div>
            <div class="form-subtitle">Enter your credentials to access the library dashboard.</div>

            <form onsubmit="event.preventDefault(); login();">
                <!-- Username -->
                <div class="form-group-custom">
                    <label for="txtUserName">User Name</label>
                    <div class="input-box">
                        <input type="text" id="txtUserName" class="input-field" placeholder="Enter username" required autocomplete="username" />
                        <i class="fas fa-user input-icon"></i>
                    </div>
                </div>

                <!-- Password -->
                <div class="form-group-custom">
                    <label for="txtPassword">Password</label>
                    <div class="input-box">
                        <input type="password" id="txtPassword" class="input-field" placeholder="••••••••" required autocomplete="current-password" />
                        <i class="fas fa-lock input-icon"></i>
                        <button type="button" class="btn-eye" onclick="togglePassword()" title="Toggle Password">
                            <i class="fas fa-eye" id="eyeIcon"></i>
                        </button>
                    </div>
                </div>

                <!-- Account Type -->
                <div class="form-group-custom">
                    <label for="ddlLoginType">Login Type</label>
                    <div class="input-box">
                        <select id="ddlLoginType" class="input-field" required>
                            <option value="">Loading...</option>
                        </select>
                        <i class="fas fa-shield-alt input-icon"></i>
                        <i class="fas fa-chevron-down select-arrow"></i>
                    </div>
                </div>

                <!-- Meta Options -->
                <div class="form-meta">
                    <label class="checkbox-label">
                        <input type="checkbox" id="rememberMe">
                        <span>Remember me</span>
                    </label>
                    <a href="#" class="link-forgot">Forgot Password?</a>
                </div>

                <!-- Submit Button -->
                <button type="submit" class="btn-submit">
                    <span>Login to System</span>
                    <i class="fas fa-arrow-right"></i>
                </button>
            </form>

            <div class="form-footer">
                &copy; 2026 LibMaster Solutions &bull; All Rights Reserved
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        // ================= PASSWORD TOGGLE =================
        function togglePassword() {
            const pwd = document.getElementById('txtPassword');
            const icon = document.getElementById('eyeIcon');

            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.className = 'fas fa-eye-slash';
            } else {
                pwd.type = 'password';
                icon.className = 'fas fa-eye';
            }
        }

        // ================= PAGE LOAD =================
        window.onload = function () {
            loadLoginTypes();
        };

        // ================= LOAD LOGIN TYPES =================
        async function loadLoginTypes() {
            try {
                let response = await fetch('/api/Login/GetLoginTypes');
                let data = await response.json();
                let ddl = document.getElementById("ddlLoginType");

                ddl.innerHTML = '<option value="">Select Account Type</option>';
                data.forEach(item => {
                    ddl.innerHTML += `<option value="${item}">${item}</option>`;
                });
            } catch (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'System Error',
                    text: 'Unable to load login types.',
                    confirmButtonColor: '#3b82f6'
                });
            }
        }

        // ================= LOGIN =================
        async function login() {
            let userName = document.getElementById("txtUserName").value.trim();
            let password = document.getElementById("txtPassword").value.trim();
            let loginType = document.getElementById("ddlLoginType").value;

            if (!userName || !password || !loginType) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Missing Information',
                    text: 'Please complete all required fields.',
                    confirmButtonColor: '#f59e0b'
                });
                return;
            }

            Swal.fire({
                title: 'Authenticating...',
                text: 'Please wait while verifying credentials',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            try {
                let response = await fetch('/api/Login/EnterOk', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({
                        userName: userName,
                        password: password,
                        loginType: loginType
                    })
                });

                let result = await response.json();

                if (!response.ok) {
                    Swal.fire({
                        icon: 'error',
                        title: "Login Failed",
                        html: `
                            <div style="font-size:14px; color:#475569;">
                                Invalid Username, Password, or Login Type.
                            </div>
                        `,
                        confirmButtonText: 'Try Again',
                        confirmButtonColor: '#ef4444'
                    });
                    return;
                }

                Swal.fire({
                    icon: 'success',
                    title: 'Welcome Back',
                    text: 'Redirecting to dashboard...',
                    showConfirmButton: false,
                    timer: 1800,
                    timerProgressBar: true
                });

                setTimeout(() => {
                    window.location.href = "/Dashboard";
                }, 1600);

            } catch (err) {
                Swal.fire({
                    icon: 'error',
                    title: 'Connection Error',
                    text: 'Unable to connect to server. Please try again later.',
                    confirmButtonColor: '#ef4444'
                });
            }
        }
    </script>
</body>
</html>