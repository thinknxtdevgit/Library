@{
    ViewData["Title"] = "Login";
}

<h2>Library Login</h2>

<div style="width:300px;">
    <label>User Name</label>
    <input type="text" id="username" class="form-control" />

    <label>Password</label>
    <input type="password" id="password" class="form-control" />

    <label>Login Type</label>
    <select id="loginType" class="form-control"></select>

    <br />
    <button onclick="login()" class="btn btn-primary">Login</button>
</div>

<hr />

<h3>Result:</h3>
<pre id="result"></pre>

<script>
    // 🔹 Load Login Types
    async function loadLoginTypes() {
        let res = await fetch('/api/Login/GetLoginTypes');
        let data = await res.json();

        let dropdown = document.getElementById("loginType");
        dropdown.innerHTML = "";

        data.forEach(x => {
            let opt = document.createElement("option");
            opt.value = x;
            opt.text = x;
            dropdown.appendChild(opt);
        });
    }

    // 🔹 Login API Call
    async function login() {
        let model = {
            userName: document.getElementById("username").value,
            password: document.getElementById("password").value,
            loginType: document.getElementById("loginType").value
        };

        let res = await fetch('/api/Login/EnterOk', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json'
            },
            body: JSON.stringify(model)
        });

        let resultBox = document.getElementById("result");

        if (res.ok) {
            let data = await res.json();
            resultBox.innerText = JSON.stringify(data, null, 2);
        } else {
            let error = await res.text();
            resultBox.innerText = error;
        }
    }

    // Load on page start
    loadLoginTypes();
</script>