@{
    ViewData["Title"] = "Login";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Library Login</title>

    <style>
            body {
                font-family: Arial;
                background-color: #f4f4f4;
            }

            .login-box {
                width: 350px;
                margin: 80px auto;
                background: white;
                padding: 25px;
                border-radius: 8px;
                box-shadow: 0px 0px 10px #ccc;
            }

            h2 {
                text-align: center;
                margin-bottom: 25px;
            }

            .form-group {
                margin-bottom: 15px;
            }

            label {
                font-weight: bold;
            }

            input, select {
                width: 100%;
                padding: 10px;
                margin-top: 5px;
            }

            button {
                width: 100%;
                padding: 10px;
                background: #0078d7;
                color: white;
                border: none;
                cursor: pointer;
            }

                button:hover {
                    background: #005fa3;
                }

            .message {
                margin-top: 15px;
                text-align: center;
                font-weight: bold;
            }

            .success {
                color: green;
            }

            .error {
                color: red;
            }
    </style>
</head>
<body>

    <div class="login-box">

        <h2>Library Login</h2>

        <div class="form-group">
            <label>User Name</label>
            <input type="text" id="txtUserName" />
        </div>

        <div class="form-group">
            <label>Password</label>
            <input type="password" id="txtPassword" />
        </div>

        <div class="form-group">
            <label>Login Type</label>
            <select id="ddlLoginType">
                <option value="">Loading...</option>
            </select>
        </div>

        <button onclick="login()">Login</button>

        <div id="message" class="message"></div>

    </div>

    <script>

            // Load Login Types
            window.onload = function () {
                loadLoginTypes();
            };

            async function loadLoginTypes() {

                let response = await fetch('/api/Login/GetLoginTypes');

                let data = await response.json();

                let ddl = document.getElementById("ddlLoginType");

                ddl.innerHTML = '<option value="">Select</option>';

                data.forEach(item => {

                    ddl.innerHTML += `<option value="${item}">${item}</option>`;

                });
            }

            // Login API Call
            async function login() {

                let userName = document.getElementById("txtUserName").value;

                let password = document.getElementById("txtPassword").value;

                let loginType = document.getElementById("ddlLoginType").value;

                let response = await fetch('/api/Login/EnterOk', {

                    method: 'POST',

                    headers: {
                        'Content-Type': 'application/json'
                    },

                    body: JSON.stringify({
                        userName: userName,
                        password: password,
                        loginType: loginType
                    })
                });

                let messageDiv = document.getElementById("message");

                if (response.ok) {

                    let result = await response.json();

                    messageDiv.className = "message success";

                    messageDiv.innerHTML =
                        "Login Successful : " + result.userName;

                    console.log(result);

                }
                else {

                    let error = await response.text();

                    messageDiv.className = "message error";

                    messageDiv.innerHTML = error;
                }
            }

    </script>

</body>
</html>