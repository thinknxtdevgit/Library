@{
    ViewData["Title"] = "Issued Books Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fade-in">
    <div class="page-header mt-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Inventory & Issuance Reports</h2>
            <p class="text-muted">Analyze global book catalog metrics, track checkout statistics, and export detailed spreadsheets.</p>
        </div>
        <div class="d-flex gap-2 w-100-mobile">
            <button class="btn btn-modern btn-primary-modern btn-auto-width text-white" style="background: linear-gradient(135deg, var(--success) 0%, #15803d 100%); box-shadow: 0 4px 14px rgba(34, 197, 94, 0.3);" onclick="downloadExcel()">
                <i class="fas fa-file-excel me-2"></i> Export Excel
            </button>
        </div>
    </div>

    <!-- Search & Filters -->
    <div class="modern-card mb-4 glass border-0">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-bold text-muted">College / Institution Filter</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-top-left-radius: var(--radius-md); border-bottom-left-radius: var(--radius-md);"><i class="fas fa-university text-muted"></i></span>
                    <input type="text" id="collegeName" class="form-input-modern" style="border-top-left-radius:0; border-bottom-left-radius:0;" placeholder="Search by college name..." />
                </div>
            </div>
            <div class="col-md-3">
                <button class="btn btn-modern btn-primary-modern w-100 py-2 text-white" onclick="loadReport()">
                    <i class="fas fa-filter me-2"></i> Apply Filter
                </button>
            </div>
            <div class="col-md-4 text-end d-none d-md-block">
                <div class="text-muted small">Showing results for: <span class="fw-bold text-primary" id="currentFilterDisplay">Global Catalog</span></div>
            </div>
        </div>
    </div>

    <!-- Summary Metrics -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="modern-card text-center bg-white" style="border-top: 4px solid var(--primary);">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fas fa-layer-group fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase mb-1">Total Books</p>
                <h2 class="fw-bold mb-0 text-primary" id="totalBooks">0</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="modern-card text-center bg-white" style="border-top: 4px solid var(--warning);">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fas fa-sign-out-alt fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase mb-1">Issued Books</p>
                <h2 class="fw-bold mb-0 text-warning" id="issuedBooks">0</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="modern-card text-center bg-white" style="border-top: 4px solid var(--success);">
                <div class="bg-success bg-opacity-10 text-success rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fas fa-check-circle fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase mb-1">Unissued Books</p>
                <h2 class="fw-bold mb-0 text-success" id="unissuedBooks">0</h2>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="modern-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0">Detailed Inventory Records</h5>
            <div class="small badge badge-modern badge-modern-primary" id="rowCountDisplay">No records loaded</div>
        </div>
        <div class="table-responsive-modern">
            <table class="table custom-table mb-0" id="reportTable">
                <thead id="tableHead">
                    <!-- Dynamic Headers -->
                </thead>
                <tbody id="tableBody">
                    <tr>
                        <td class="text-center py-5 text-muted">
                            <i class="fas fa-search fa-3x mb-3 opacity-20 text-primary animate-pulse"></i>
                            <p class="mb-0">Enter a college name and click filter to populate records dynamically.</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        async function loadReport() {
            const collegeName = document.getElementById("collegeName").value;
            if (!collegeName) { alert("Please enter a College Name to filter."); return; }

            $("#currentFilterDisplay").text(collegeName);
            
            try {
                const response = await fetch('/api/report/college', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ collegeName: collegeName })
                });

                if (!response.ok) {
                    const error = await response.text();
                    alert(error);
                    return;
                }

                const data = await response.json();
                document.getElementById("totalBooks").innerText = data.totalBooks;
                document.getElementById("issuedBooks").innerText = data.issuedBooks;
                document.getElementById("unissuedBooks").innerText = data.unissuedBooks;

                const tableHead = document.getElementById("tableHead");
                const tableBody = document.getElementById("tableBody");
                tableHead.innerHTML = "";
                tableBody.innerHTML = "";

                if (!data.issueBooks || data.issueBooks.length === 0) {
                    tableBody.innerHTML = `<tr><td class="text-center py-5 text-muted">No data found for this filter.</td></tr>`;
                    $("#rowCountDisplay").text("0 records found");
                    return;
                }

                // Header
                let headerLine = "<tr>";
                Object.keys(data.issueBooks[0]).forEach(key => {
                    headerLine += `<th class="border-0 text-uppercase small fw-bold p-3">${key.replace(/([A-Z])/g, ' $1').trim()}</th>`;
                });
                headerLine += "</tr>";
                tableHead.innerHTML = headerLine;

                // Body
                let rows = "";
                data.issueBooks.forEach(item => {
                    rows += "<tr>";
                    Object.values(item).forEach(value => {
                        rows += `<td class="p-3 small text-muted">${value ?? "-"}</td>`;
                    });
                    rows += "</tr>";
                });
                tableBody.innerHTML = rows;
                $("#rowCountDisplay").text(data.issueBooks.length + " records loaded");

            } catch (error) {
                console.error(error);
                alert("An error occurred while fetching the report.");
            }
        }

        async function downloadExcel() {
            const collegeName = document.getElementById("collegeName").value;
            if (!collegeName) { alert("Specify a College Name before exporting."); return; }

            try {
                const response = await fetch('/api/report/college/export', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ collegeName: collegeName })
                });

                if (!response.ok) { alert("Download Failed"); return; }

                const blob = await response.blob();
                const url = window.URL.createObjectURL(blob);
                const a = document.createElement('a');
                a.href = url;
                a.download = `${collegeName}_Inventory_Report_${new Date().toLocaleDateString()}.xlsx`;
                document.body.appendChild(a);
                a.click();
                a.remove();
            } catch (error) {
                console.error(error);
                alert("Excel Export failed.");
            }
        }
    </script>
}