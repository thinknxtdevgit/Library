@{
    ViewData["Title"] = "Issued Books Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fade-in">
    <div class="page-header mt-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Issue Books Detail</h2>
            <p class="text-muted">Analyze global book catalog metrics, track checkout statistics, and export detailed spreadsheets.</p>
        </div>
        <div class="d-flex gap-2 w-100-mobile">
            <button class="btn btn-modern btn-primary-modern btn-auto-width text-white" style="background: linear-gradient(135deg, var(--success) 0%, #15803d 100%); box-shadow: 0 4px 14px rgba(34, 197, 94, 0.3);" onclick="downloadExcel()">
                <i class="fas fa-file-excel me-2"></i> Export Excel
            </button>
        </div>
    </div>

    <!-- Search & Filters -->
    <div class="modern-card mb-4 glass border-0">
        <div class="row g-3 align-items-end">
            <div class="col-md-5">
                <label class="form-label small fw-bold text-muted">College / Institution Filter</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-top-left-radius: var(--radius-md); border-bottom-left-radius: var(--radius-md);"><i class="fas fa-university text-muted"></i></span>
                    <select id="collegeName" class="form-input-modern">
                        <option value="">-- Select College --</option>
                    </select>
                </div>
            </div>
            <div class="col-md-3">
                <button class="btn btn-modern btn-primary-modern w-100 py-2 text-white" onclick="loadReport(1)">
                    <i class="fas fa-filter me-2"></i> Apply Filter
                </button>
            </div>
            <div class="col-md-4 text-end d-none d-md-block">
                <div class="text-muted small">Showing results for: <span class="fw-bold text-primary" id="currentFilterDisplay">Global Catalog</span></div>
            </div>
        </div>
    </div>

    <!-- Summary Metrics -->
    <div class="row g-4 mb-4">
        <div class="col-md-4">
            <div class="modern-card text-center bg-white" style="border-top: 4px solid var(--primary);">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fas fa-layer-group fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase mb-1">Total Books</p>
                <h2 class="fw-bold mb-0 text-primary" id="totalBooks">0</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="modern-card text-center bg-white" style="border-top: 4px solid var(--warning);">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fas fa-sign-out-alt fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase mb-1">Issued Books</p>
                <h2 class="fw-bold mb-0 text-warning" id="issuedBooks">0</h2>
            </div>
        </div>
        <div class="col-md-4">
            <div class="modern-card text-center bg-white" style="border-top: 4px solid var(--success);">
                <div class="bg-success bg-opacity-10 text-success rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                    <i class="fas fa-check-circle fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase mb-1">Unissued Books</p>
                <h2 class="fw-bold mb-0 text-success" id="unissuedBooks">0</h2>
            </div>
        </div>
    </div>

    <!-- Data Table -->
    <div class="modern-card">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h5 class="fw-bold mb-0">Detailed Inventory Records</h5>
            <div class="small badge badge-modern badge-modern-primary" id="rowCountDisplay">No records loaded</div>
        </div>
        <div class="table-responsive-modern">
            <table class="table custom-table mb-0" id="reportTable">
                <thead id="tableHead">
                    <!-- Dynamic Headers -->
                </thead>
                <tbody id="tableBody">
                    <tr>
                        <td class="text-center py-5 text-muted">
                            <i class="fas fa-search fa-3x mb-3 opacity-20 text-primary animate-pulse"></i>
                            <p class="mb-0">Enter a college name and click filter to populate records dynamically.</p>
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div id="pagination"
             class="mt-3 d-flex justify-content-center gap-2">
        </div>
    </div>
</div>
@section Scripts {
    <script>

        let currentPage = 1;
        let pageSize = 10;
        let totalPages = 0;

        // ================= INIT =================
        document.addEventListener("DOMContentLoaded", async () => {
            await loadColleges();
            // Data loading requires explicit college selection
        });

        // ================= HELPERS =================
        function showLoader() {
            Swal.fire({
                title: 'Loading Report...',
                allowOutsideClick: false,
                didOpen: () => Swal.showLoading()
            });
        }

        function hideLoader() {
            Swal.close();
        }

        async function postJson(url, data) {
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(data)
            });

            if (!response.ok) {
                throw new Error(await response.text());
            }

            return await response.json();
        }

        // ================= LOAD COLLEGES =================
        async function loadColleges() {
            try {

                const res = await fetch('/api/report/colleges');
                const colleges = await res.json();

                const ddl = document.getElementById("collegeName");

                ddl.innerHTML =
                    `<option value="">-- Select College --</option>` +
                    colleges.map(c =>
                        `<option value="${c}">${c}</option>`
                    ).join('');

            }
            catch (err) {
                console.error("College load failed:", err);
            }
        }

        // ================= LOAD REPORT =================
        async function loadReport(page = 1) {

            currentPage = page;
            const collegeName = document.getElementById("collegeName").value;

            if (!collegeName) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Select College Name',
                    text: 'Please select a college name to view issued books report.',
                    confirmButtonColor: '#f39c12'
                });
                return;
            }

            const currentFilterSpan = document.getElementById("currentFilterDisplay");
            if (currentFilterSpan) {
                currentFilterSpan.innerText = collegeName;
            }

            try {

                showLoader();

                // ================= SUMMARY =================
                const summary = await postJson(
                    '/api/report/college',
                    { collegeName: collegeName }
                );

                document.getElementById("totalBooks").innerText =
                    summary.totalBooks ?? 0;

                document.getElementById("issuedBooks").innerText =
                    summary.issuedBooks ?? 0;

                document.getElementById("unissuedBooks").innerText =
                    summary.unissuedBooks ?? 0;

                // ================= PAGED DATA =================
                const pagedResult = await postJson(
                    '/Reports/GetStockPaged',
                    {
                        search: collegeName,
                        pageNumber: currentPage,
                        pageSize: pageSize
                    }
                );

                renderTable(pagedResult);

                document.getElementById("rowCountDisplay").innerText =
                    `${pagedResult.totalRecords ?? 0} Records`;

                totalPages = Math.ceil(
                    (pagedResult.totalRecords ?? 0) / pageSize
                );

                if (totalPages <= 0)
                    totalPages = 1;

                renderPagination();
            }
            catch (err) {

                console.error(err);

                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: err.message || 'Something went wrong.'
                });
            }
            finally {

                hideLoader();
            }
        }

        // ================= TABLE =================
        function renderTable(result) {

            const tableHead =
                document.getElementById("tableHead");

            const tableBody =
                document.getElementById("tableBody");

            tableHead.innerHTML = "";
            tableBody.innerHTML = "";

            if (!result.data || result.data.length === 0) {

                tableBody.innerHTML = `
                    <tr>
                        <td class="text-center py-4 text-muted">
                            No Records Found
                        </td>
                    </tr>
                `;

                return;
            }

            const columnMap = {
                issueDate: "Issue Date",
                idNo: "ID No",
                whomIssued: "Whom Issued",
                discipline: "Discipline",
                accessionNo: "Accession No",
                title: "Book Title",
                author: "Author",
                lastReturnDate: "Return Date",
                condition: "Condition",
                type: "Type",
                category: "Category",
                receiveDate: "Receive Date",
                remarks: "Remarks"
            };

            // Header
            let header = "<tr>";

            Object.keys(result.data[0]).forEach(key => {
                header += `<th>${columnMap[key] || key}</th>`;
            });

            header += "</tr>";

            tableHead.innerHTML = header;

            // Body
            let rows = "";

            result.data.forEach(item => {

                rows += "<tr>";

                Object.values(item).forEach(value => {
                    rows += `<td>${value ?? '-'}</td>`;
                });

                rows += "</tr>";
            });

            tableBody.innerHTML = rows;
        }

        // ================= PAGINATION =================
        function renderPagination() {

            let html = "";

            if (currentPage > 1) {
                html += `
                    <button class="btn btn-sm btn-primary me-2"
                        onclick="loadReport(${currentPage - 1})">
                        Prev
                    </button>
                `;
            }

            html += `
                <span class="px-3 align-self-center text-muted fw-bold">
                    Page ${currentPage} of ${totalPages}
                </span>
            `;

            if (currentPage < totalPages) {
                html += `
                    <button class="btn btn-sm btn-primary ms-2"
                        onclick="loadReport(${currentPage + 1})">
                        Next
                    </button>
                `;
            }

            document.getElementById("pagination").innerHTML = html;
        }

        // ================= EXPORT EXCEL =================
        async function downloadExcel() {

            const collegeName =
                document.getElementById("collegeName").value;

            if (!collegeName) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Select College Name',
                    text: 'Please select a college name to export report.',
                    confirmButtonColor: '#f39c12'
                });
                return;
            }

            try {

                showLoader();

                const response = await fetch(
                    '/api/report/college/export',
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({ collegeName: collegeName })
                    });

                if (!response.ok) throw new Error("Export failed");

                const blob = await response.blob();

                const url =
                    window.URL.createObjectURL(blob);

                const a =
                    document.createElement("a");

                a.href = url;
                a.download = `${collegeName}_Report.xlsx`;

                document.body.appendChild(a);
                a.click();
                a.remove();
            }
            catch (err) {

                Swal.fire({
                    icon: 'error',
                    title: 'Export Failed',
                    text: err.message || 'Export failed'
                });
            }
            finally {

                hideLoader();
            }
        }

    </script>
}
