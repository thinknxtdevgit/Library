@{
    ViewData["Title"] = "Issued Books Report";
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Issued Books Report</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

</head>
<body>

    <div class="container mt-4">

        <h3 class="mb-4">
            Issued Books Report
        </h3>

        <!-- SEARCH -->

        <div class="row mb-3">

            <div class="col-md-4">

                <input type="text"
                       id="collegeName"
                       class="form-control"
                       placeholder="Enter College Name" />

            </div>

            <div class="col-md-8">

                <button class="btn btn-primary"
                        onclick="loadReport()">
                    Get Report
                </button>

                <button class="btn btn-success"
                        onclick="downloadExcel()">
                    Export Excel
                </button>

            </div>

        </div>

        <!-- SUMMARY -->

        <div class="row mb-4">

            <div class="col-md-4">

                <div class="card text-center">

                    <div class="card-body">

                        <h5>Total Books</h5>

                        <h3 id="totalBooks">0</h3>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card text-center">

                    <div class="card-body">

                        <h5>Issued Books</h5>

                        <h3 id="issuedBooks">0</h3>

                    </div>

                </div>

            </div>

            <div class="col-md-4">

                <div class="card text-center">

                    <div class="card-body">

                        <h5>Unissued Books</h5>

                        <h3 id="unissuedBooks">0</h3>

                    </div>

                </div>

            </div>

        </div>

        <!-- TABLE -->

        <div class="table-responsive">

            <table class="table table-bordered table-striped"
                   id="reportTable">

                <thead id="tableHead"></thead>

                <tbody id="tableBody"></tbody>

            </table>

        </div>

    </div>

    <script>

            async function loadReport() {

                const collegeName =
                    document.getElementById("collegeName").value;

                if (!collegeName) {

                    alert("Enter College Name");

                    return;
                }

                try {

                    const response =
                        await fetch('/api/report/college', {

                        method: 'POST',

                        headers: {
                            'Content-Type': 'application/json'
                        },

                        body: JSON.stringify({
                            collegeName: collegeName
                        })

                    });

                    if (!response.ok) {

                        const error =
                            await response.text();

                        alert(error);

                        return;
                    }

                    const data =
                        await response.json();

                    // COUNTS

                    document.getElementById("totalBooks").innerText =
                        data.totalBooks;

                    document.getElementById("issuedBooks").innerText =
                        data.issuedBooks;

                    document.getElementById("unissuedBooks").innerText =
                        data.unissuedBooks;

                    // TABLE

                    const tableHead =
                        document.getElementById("tableHead");

                    const tableBody =
                        document.getElementById("tableBody");

                    tableHead.innerHTML = "";

                    tableBody.innerHTML = "";

                    if (!data.issueBooks ||
                        data.issueBooks.length === 0) {

                        tableBody.innerHTML = `
                            <tr>
                                <td class="text-center">
                                    No Data Found
                                </td>
                            </tr>
                        `;

                        return;
                    }

                    // HEADER

                    let header = "<tr>";

                    Object.keys(data.issueBooks[0]).forEach(key => {

                        header += `<th>${key}</th>`;

                    });

                    header += "</tr>";

                    tableHead.innerHTML = header;

                    // BODY

                    let rows = "";

                    data.issueBooks.forEach(item => {

                        rows += "<tr>";

                        Object.values(item).forEach(value => {

                            rows += `<td>${value ?? ""}</td>`;

                        });

                        rows += "</tr>";

                    });

                    tableBody.innerHTML = rows;

                }
                catch (error) {

                    console.log(error);

                    alert("Something went wrong");
                }
            }

            async function downloadExcel() {

                const collegeName =
                    document.getElementById("collegeName").value;

                if (!collegeName) {

                    alert("Enter College Name");

                    return;
                }

                try {

                    const response =
                        await fetch('/api/report/college/export', {

                        method: 'POST',

                        headers: {
                            'Content-Type': 'application/json'
                        },

                        body: JSON.stringify({
                            collegeName: collegeName
                        })

                    });

                    if (!response.ok) {

                        alert("Download Failed");

                        return;
                    }

                    const blob =
                        await response.blob();

                    const url =
                        window.URL.createObjectURL(blob);

                    const a =
                        document.createElement('a');

                    a.href = url;

                    a.download =
                        `${collegeName}_Report.xlsx`;

                    document.body.appendChild(a);

                    a.click();

                    a.remove();

                }
                catch (error) {

                    console.log(error);

                    alert("Excel Download Failed");
                }
            }

    </script>

</body>
</html>