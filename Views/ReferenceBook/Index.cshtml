@{
    ViewData["Title"] = "Reference Books Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fade-in">

    <!-- HEADER -->
    <div class="page-header mt-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Reference Books Report</h2>
            <p class="text-muted">
                Analyze library reference books, track valuation and details.
            </p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-modern btn-primary-modern text-white"
                    style="background: linear-gradient(135deg, #22c55e, #15803d);"
                    onclick="exportExcel()">
                <i class="fas fa-file-excel me-2"></i> Export Excel
            </button>
        </div>
    </div>

    <!-- FILTER CARD -->
    <div class="modern-card mb-4 glass border-0">
        <div class="row g-3 align-items-end">

            <div class="col-md-5">
                <label class="form-label small fw-bold text-muted">College Filter</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0">
                        <i class="fas fa-university text-muted"></i>
                    </span>
                    <select id="collegeName" class="form-input-modern">
                        <option value="">-- Select College --</option>
                    </select>
                </div>
            </div>

            <div class="col-md-3">
                <button class="btn btn-modern btn-primary-modern w-100 text-white"
                        onclick="loadReport(1)">
                    <i class="fas fa-filter me-2"></i> Apply Filter
                </button>
            </div>

            <div class="col-md-4 text-end d-none d-md-block">
                <div class="text-muted small">
                    Showing: <span class="fw-bold text-primary" id="currentFilter">Global Reference Stock</span>
                </div>
            </div>

        </div>
    </div>

   @*  <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="modern-card text-center bg-white"
                 style="border-top: 4px solid var(--primary);">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="width:50px;height:50px;">
                    <i class="fas fa-book fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase">Total Books</p>
                <h2 class="fw-bold text-primary" id="totalBooks">0</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="modern-card text-center bg-white"
                 style="border-top: 4px solid var(--warning);">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="width:50px;height:50px;">
                    <i class="fas fa-layer-group fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase">Total Titles</p>
                <h2 class="fw-bold text-warning" id="totalTitles">0</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="modern-card text-center bg-white"
                 style="border-top: 4px solid var(--success);">
                <div class="bg-success bg-opacity-10 text-success rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="width:50px;height:50px;">
                    <i class="fas fa-indian-rupee-sign fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase">Total Valuation</p>
                <h2 class="fw-bold text-success" id="totalValuation">₹0.00</h2>
            </div>
        </div>

    </div> *@

    <!-- TABLE -->
    <div class="modern-card">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Reference Details</h5>
            <div class="small badge bg-primary" id="rowCount">0 Records</div>
        </div>

        <div class="table-responsive-modern">
            <table class="table custom-table" id="stockTable">

                <thead id="tableHead"></thead>

                <tbody id="tableBody">
                    <tr>
                        <td class="text-center py-5 text-muted">
                            <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                            <p>Apply filter to load reference data</p>
                        </td>
                    </tr>
                </tbody>
                
            </table>
        </div>
        <!-- PAGINATION -->
        <div id="pagination" class="mt-3 d-flex justify-content-center gap-2"></div>

    </div>

</div>

@section Scripts {

    <script>

        let currentPage = 1;
        let pageSize = 10;
        let totalPages = 0;

        // ================= INIT =================
          document.addEventListener("DOMContentLoaded", () => {
            loadColleges();
        });

         // ================= HELPERS =================

        function showLoader() {
            Swal.fire({
                title: 'Loading Report...',
                text: 'Please wait...',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => Swal.showLoading()
            });
        }

        function hideLoader() {
            Swal.close();
        }

        function showWarning(message) {
            Swal.fire({
                icon: 'warning',
                title: 'Validation',
                text: message
            });
        }

        function showError(message) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: message
            });
        }

        // ================= COLLEGES =================
        async function loadColleges() {

            try {

                const res = await fetch('/api/report/colleges');
                const colleges = await res.json();

                const ddl = document.getElementById("collegeName");

                ddl.innerHTML =
                    `<option value="">-- Select College --</option>` +
                    colleges.map(c =>
                        `<option value="${c}">${c}</option>`
                    ).join('');

            }
            catch (err) {

                console.error(err);

                showError('Failed to load colleges.');
            }
        }

        // ================= LOAD REPORT =================
               async function loadReport(page = 1) {

            currentPage = page;

            const collegeName =
                document.getElementById("collegeName").value;

            if (!collegeName) {

                showWarning(
                    'Please select a college name.'
                );

                return;
            }

            try {

                showLoader();

                const res = await fetch(
                    '/ReferenceBook/GetReferenceBooksPaged',
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            search: collegeName,
                            pageNumber: currentPage,
                            pageSize: pageSize
                        })
                    });

                if (!res.ok) {
                    throw new Error(
                        'Failed to load report.'
                    );
                }

                const result = await res.json();

                document.getElementById(
                    "currentFilter"
                ).innerText = collegeName;

                document.getElementById(
                    "rowCount"
                ).innerText =
                    `${result.totalRecords} Records`;

                totalPages = Math.max(
                    1,
                    Math.ceil(
                        result.totalRecords / pageSize
                    )
                );

                renderTable(result.data);

                renderPagination();
            }
            catch (err) {

                console.error(err);

                showError(
                    err.message ||
                    'Failed to load report.'
                );
            }
            finally {

                hideLoader();
            }
        }

        // ================= TABLE =================
               function renderTable(data) {

            const head =
                document.getElementById("tableHead");

            const body =
                document.getElementById("tableBody");

            head.innerHTML = "";
            body.innerHTML = "";

            if (!data || data.length === 0) {

                body.innerHTML = `
                    <tr>
                        <td colspan="100"
                            class="text-center py-4">
                            No Data Found
                        </td>
                    </tr>
                `;

                return;
            }

            const keys = Object.keys(data[0]);

            let header = "<tr>";

            keys.forEach(key => {

                header += `<th>${key}</th>`;
            });

            header += "</tr>";

            head.innerHTML = header;

            let rows = "";

            data.forEach(row => {

                rows += "<tr>";

                keys.forEach(key => {

                    let value = row[key];

                    if (
                        value === null ||
                        value === undefined
                    ) {
                        value = "-";
                    }

                    if (
                        key.toLowerCase() ===
                        "dateentry" &&
                        value !== "-"
                    ) {
                        value =
                            new Date(value)
                            .toLocaleDateString(
                                "en-IN"
                            );
                    }

                    rows += `<td>${value}</td>`;
                });

                rows += "</tr>";
            });

            body.innerHTML = rows;
        }

        // ================= PAGINATION =================
              function renderPagination() {

            let html = '';

            if (currentPage > 1) {

                html += `
                    <button
                        class="btn btn-sm btn-primary"
                        onclick="loadReport(${currentPage - 1})">
                        Prev
                    </button>
                `;
            }

            html += `
                <span class="px-3 align-self-center">
                    Page ${currentPage}
                    of
                    ${totalPages}
                </span>
            `;

            if (currentPage < totalPages) {

                html += `
                    <button
                        class="btn btn-sm btn-primary"
                        onclick="loadReport(${currentPage + 1})">
                        Next
                    </button>
                `;
            }

            document.getElementById(
                "pagination"
            ).innerHTML = html;
        }
        // ================= EXPORT =================
              async function exportExcel() {

            const collegeName =
                document.getElementById("collegeName").value;

            if (!collegeName) {

                showWarning(
                    'Please select a college.'
                );

                return;
            }

            window.location.href =
                `/ReferenceBook/ExportExcel?collegeName=${encodeURIComponent(collegeName)}`;
        }

    </script>
}
