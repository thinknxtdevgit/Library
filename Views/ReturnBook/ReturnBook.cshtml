@{
    ViewData["Title"] = "Return Book";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fade-in">
    <div class="page-header mt-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Return Book</h2>
            <p class="text-muted">Process resource returns, verify borrower metadata, and instantly restore stock items to active inventory.</p>
        </div>
        <div class="d-flex gap-2 w-100-mobile">
            <a href="/IssueBook" class="btn btn-modern btn-secondary-modern btn-auto-width text-decoration-none">
                <i class="fas fa-arrow-left me-2 text-primary"></i> Back to Issue
            </a>
        </div>
    </div>

    <div class="row g-4">
        <!-- Left Column: Return Processing -->
        <div class="col-xl-8">
            <div class="modern-card mb-4" style="border-top: 4px solid var(--danger);">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <h5 class="fw-bold mb-0"><i class="fas fa-undo-alt me-2 text-danger"></i> Return Details</h5>
                    <span class="badge badge-modern badge-modern-danger animate-pulse" id="returnStatusBadge">
                        Awaiting Input
                    </span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Accession Number</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0" style="border-top-left-radius: var(--radius-md); border-bottom-left-radius: var(--radius-md);"><i class="fas fa-barcode text-muted"></i></span>
                            <input type="text" id="rAccession" class="form-input-modern" style="border-top-left-radius:0; border-bottom-left-radius:0;" placeholder="Scan or enter Accession No..." />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Borrower ID</label>
                        <input type="text" id="rIdNo" class="form-input-modern" readonly placeholder="Auto-fills on scan" />
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Borrower Name</label>
                        <input type="text" id="rName" class="form-input-modern" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">Account Type</label>
                        <input type="text" id="rType" class="form-input-modern" readonly />
                    </div>
                    <div class="col-md-4">
                        <label class="form-label small fw-bold text-muted">College Name</label>
                        <input type="text" id="rCollegeName" class="form-input-modern" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Course / Designation</label>
                        <input type="text" id="rCourse" class="form-input-modern" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Batch / Department</label>
                        <input type="text" id="rBatch" class="form-input-modern" readonly />
                    </div>
                </div>
            </div>

            <div class="modern-card">
                <h5 class="fw-bold mb-4"><i class="fas fa-book me-2 text-primary"></i> Issued Book Metadata</h5>
                <div class="row g-3">
                    <div class="col-md-12">
                        <label class="form-label small fw-bold text-muted">Book Title</label>
                        <input type="text" id="rTitle" class="form-input-modern" readonly />
                    </div>
                    <div class="col-md-12">
                        <label class="form-label small fw-bold text-muted">Author</label>
                        <input type="text" id="rAuthor" class="form-input-modern" readonly />
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Date of Issue</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0" style="border-top-left-radius: var(--radius-md); border-bottom-left-radius: var(--radius-md);"><i class="far fa-calendar-alt text-muted"></i></span>
                            <input type="text" id="rIssueDate" class="form-input-modern" style="border-top-left-radius:0; border-bottom-left-radius:0;" readonly />
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label small fw-bold text-muted">Scheduled Return Date</label>
                        <div class="input-group">
                            <span class="input-group-text bg-transparent border-end-0" style="border-top-left-radius: var(--radius-md); border-bottom-left-radius: var(--radius-md);"><i class="far fa-calendar-check text-muted"></i></span>
                            <input type="text" id="rLastDate" class="form-input-modern" style="border-top-left-radius:0; border-bottom-left-radius:0;" readonly />
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right Column: Confirmation & Profile -->
        <div class="col-xl-4">
            <div class="modern-card glass sticky-lg-top" style="top: 100px;">
                <div class="text-center mb-4">
                    <div class="avatar-lg mx-auto mb-3" style="width: 130px; height: 130px; border-radius: var(--radius-lg); overflow: hidden;">
                        <img id="rImage" src="/images/noimage.png" class="shadow-sm border w-100 h-100" style="object-fit: cover;" />
                    </div>
                    <h5 class="fw-bold mb-1">Return Authorization</h5>
                    <p class="text-muted small">Verify borrower identity & item condition</p>
                </div>

                <div class="mb-4">
                    <label class="form-label small fw-bold text-muted">Admin Signature</label>
                    <div class="input-group">
                        <span class="input-group-text bg-transparent border-end-0" style="border-top-left-radius: var(--radius-md); border-bottom-left-radius: var(--radius-md);"><i class="fas fa-pen-nib text-muted"></i></span>
                        <input type="password" id="rSignature" class="form-input-modern" style="border-top-left-radius:0; border-bottom-left-radius:0;" placeholder="Type password..." />
                    </div>
                </div>

                <button class="btn btn-modern btn-danger-modern w-100 py-3 mb-3 text-white" onclick="returnBook()">
                    <i class="fas fa-check-double me-2"></i> Process Return
                </button>
                
                <div class="alert alert-info small border-0 bg-info bg-opacity-10 text-dark d-flex align-items-start gap-2">
                    <i class="fas fa-info-circle text-info mt-1"></i> 
                    <div>Processing a returned resource clears the active issue record instantly and updates catalog availability globally.</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // =========================
        // LOAD RETURN DETAIL
        // =========================
               $("#rAccession").blur(function () {

            let acc = $(this).val().trim();

            // ================= EMPTY CHECK =================
            if (acc == "") {

                Swal.fire({
                    icon: 'warning',
                    title: 'Accession No Required',
                    text: 'Please enter accession number.',
                    confirmButtonColor: '#f59e0b'
                });

                return;
            }

            // ================= LOADING =================
            Swal.fire({
                title: 'Searching Record...',
                text: 'Loading issued book details',
                allowOutsideClick: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });

            // ================= AJAX =================
            $.ajax({

                url: "/ReceiveBook",

                method: "POST",

                contentType: "application/json",

                data: JSON.stringify({
                    accessionNo: acc
                }),

                // ================= SUCCESS =================
                success: function (res) {

                    Swal.close();

                    // ================= FAILED RESPONSE =================
                    if (!res.success) {

                        $("#returnStatusBadge")
                            .text("Error")
                            .addClass("badge-modern-danger")
                            .removeClass("badge-modern-success");

                        Swal.fire({
                            icon: 'error',
                            title: 'Book Not Found',
                            text: res.message,
                            confirmButtonColor: '#d33',
                            footer: 'Library Management System'
                        });

                        return;
                    }

                    // ================= DATA BIND =================
                    let d = res.data;

                    $("#rIdNo").val(d.idNo);

                    $("#rName").val(d.name);

                    $("#rType").val(d.type);

                    $("#rTitle").val(d.title);

                    $("#rAuthor").val(d.author);

                    $("#rCollegeName").val(d.college);

                    $("#rIssueDate")
                        .val(formatDate(d.issueDate));

                    $("#rLastDate")
                        .val(formatDate(d.lastReturnDate));

                    // ================= STATUS BADGE =================
                    $("#returnStatusBadge")
                        .text("Ready to Process")
                        .addClass("badge-modern-success")
                        .removeClass("badge-modern-danger");

                    // ================= EXTRA DETAIL =================
                    if (d.extraDetail) {

                        $("#rCourse")
                            .val(d.extraDetail.course);

                        $("#rBatch")
                            .val(d.extraDetail.batch);
                    }

                    // ================= IMAGE =================
                    if (d.snap) {

                        $("#rImage").attr("src", d.snap);

                    } else {

                        $("#rImage")
                            .attr("src", "/images/noimage.png");
                    }

                    // ================= SUCCESS ALERT =================
                    Swal.fire({

                        icon: 'success',

                        title: 'Book Record Loaded',

                        text: 'Book return details loaded successfully.',

                        timer: 1800,

                        showConfirmButton: false
                    });
                },

                // ================= ERROR =================
                error: function (err) {

                    Swal.close();

                    $("#returnStatusBadge")
                        .text("Error")
                        .addClass("badge-modern-danger")
                        .removeClass("badge-modern-success");

                    let msg =
                        err.responseJSON?.message ||
                        err.responseText ||
                        "Unable to load data";

                    // ================= CLEAR FIELDS =================
                    $("#rIdNo").val('');

                    $("#rName").val('');

                    $("#rType").val('');

                    $("#rTitle").val('');

                    $("#rAuthor").val('');

                    $("#rCollegeName").val('');

                    $("#rIssueDate").val('');

                    $("#rLastDate").val('');

                    $("#rCourse").val('');

                    $("#rBatch").val('');

                    $("#rImage").attr("src", "/images/noimage.png");

                    // ================= ERROR ALERT =================
                    Swal.fire({

                        icon: 'error',

                        title: 'Data Load Failed',

                        text: msg,

                        confirmButtonColor: '#d33',

                        footer: 'Please verify accession number'
                    });
                }
            });
        });

        // =========================
        // RETURN BOOK
        // =========================
               function returnBook() {

            let data = {

                accessionNo: $("#rAccession").val().trim(),

                signature: $("#rSignature").val().trim()
            };

            // ================= VALIDATION =================

            if (!data.accessionNo) {

                Swal.fire({
                    icon: 'warning',
                    title: 'Accession No Required',
                    text: 'Please enter accession number.',
                    confirmButtonColor: '#f59e0b'
                });

                return;
            }

            if (!data.signature) {

                Swal.fire({
                    icon: 'warning',
                    title: 'Admin Signature Required',
                    text: 'Please enter admin signature.',
                    confirmButtonColor: '#f59e0b'
                });

                return;
            }

            // ================= CONFIRMATION =================

            Swal.fire({

                title: 'Confirm Book Return',

                text: 'Are you sure you want to return this book?',

                icon: 'question',

                showCancelButton: true,

                confirmButtonColor: '#28a745',

                cancelButtonColor: '#d33',

                confirmButtonText: 'Yes, Return Book'
            })

            .then((result) => {

                if (!result.isConfirmed) return;

                // ================= LOADING =================

                Swal.fire({

                    title: 'Processing Return...',

                    text: 'Please wait while book return is processing',

                    allowOutsideClick: false,

                    didOpen: () => {
                        Swal.showLoading();
                    }
                });

                // ================= AJAX =================

                $.ajax({

                    url: "/ReceiveBook",

                    method: "POST",

                    contentType: "application/json",

                    data: JSON.stringify(data),

                    // ================= SUCCESS =================

                    success: function (res) {

                        Swal.close();

                        // ===== SUCCESS STATUS =====

                        $("#returnStatusBadge")
                            .text("Book Returned")
                            .addClass("badge-modern-success")
                            .removeClass("badge-modern-danger");

                        Swal.fire({

                            icon: 'success',

                            title: 'Book Returned Successfully',

                            text: res.message,

                            confirmButtonColor: '#28a745'

                        }).then(() => {

                            location.reload();
                        });
                    },

                    // ================= ERROR =================

                    error: function (err) {

                        Swal.close();

                        $("#returnStatusBadge")
                            .text("Return Failed")
                            .addClass("badge-modern-danger")
                            .removeClass("badge-modern-success");

                        let msg =
                            err.responseJSON?.message ||
                            err.responseText ||
                            "Return Book Error";

                        Swal.fire({

                            icon: 'error',

                            title: 'Return Failed',

                            text: msg,

                            confirmButtonColor: '#d33',

                            footer: 'Library Management System'
                        });
                    }
                });
            });
        }

        // ================= DATE FORMAT =================

        function formatDate(dateString) {

            if (!dateString) return "-";

            let d = new Date(dateString);

            return d.toLocaleDateString('en-GB', {

                day: '2-digit',

                month: '2-digit',

                year: 'numeric'
            });
        }
    </script>
}