@{
    ViewData["Title"] = "Student Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fade-in">
    <!-- Page Header -->
    <div class="page-header mt-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="fas fa-user-graduate text-primary me-2"></i>Student Profiles
            </h2>
            <p class="text-muted">Manage student admission records, edit roll numbers, profile information, and export lists.</p>
        </div>
        <div class="d-flex gap-2 w-100-mobile">
            <button class="btn btn-modern btn-secondary-modern btn-auto-width" id="btnExport" disabled style="background: linear-gradient(135deg, var(--success) 0%, #15803d 100%); color: white; box-shadow: 0 4px 14px rgba(34, 197, 94, 0.3);">
                <i class="fas fa-file-excel me-2"></i> Export Excel
            </button>
            <button class="btn btn-modern btn-primary-modern btn-auto-width text-white" id="btnAdd" disabled>
                <i class="fas fa-plus me-2"></i> Add Student
            </button>
        </div>
    </div>

    <!-- Filters Panel -->
    <div class="modern-card mb-4 glass border-0">
        <div class="row g-3 align-items-end">
            <!-- College Selector -->
            <div class="col-lg-9 col-md-8">
                <label class="form-label small fw-bold text-muted mb-2">College / Institution</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-top-left-radius: var(--radius-md); border-bottom-left-radius: var(--radius-md); border-color: var(--border-color);">
                        <i class="fas fa-university text-muted"></i>
                    </span>
                    <select id="ddlCollege" class="form-input-modern" style="border-top-left-radius:0; border-bottom-left-radius:0;">
                        <option value="">-- Loading Colleges... --</option>
                    </select>
                </div>
            </div>

            <!-- Apply Filter Button -->
            <div class="col-lg-3 col-md-4">
                <button class="btn btn-modern btn-primary-modern w-100 py-2 text-white" id="btnSearch" disabled>
                    <i class="fas fa-search me-2"></i> Apply Filter
                </button>
            </div>
        </div>
    </div>

    <!-- Results Display Panel -->
    <div class="row">
        <div class="col-12">
            <div class="modern-card shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-main" id="resultsTitle">Students Directory</h5>
                    <span class="badge badge-modern badge-modern-primary" id="recordCountDisplay">0 Records Found</span>
                </div>

                <!-- Desktop/Tablet Table View -->
                <div class="table-responsive-modern d-none d-md-block" id="desktopView">
                    <table class="table custom-table mb-0" id="resultsTable">
                        <thead>
                            <tr>
                                <th class="ps-4">ID No</th>
                                <th>Class Roll No</th>
                                <th>Uni Roll No</th>
                                <th>Student Name</th>
                                <th>Course</th>
                                <th>Batch</th>
                                <th>Mobile No</th>
                                <th>Email</th>
                                <th class="pe-4 text-center">Actions</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                                    <p class="mb-0">Select college filters and click Apply Filter to display student records.</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="d-block d-md-none" id="mobileView">
                    <div id="mobileCardsContainer">
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                            <p class="mb-0">Select college filters and click Apply Filter to display student records.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Add/Edit Student Modal -->
<div class="modal fade" id="studentModal" tabindex="-1" aria-labelledby="studentModalLabel" aria-hidden="true" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content" style="background: var(--bg-card); color: var(--text-main); border: 1px solid var(--border-color); border-radius: var(--radius-lg);">
            <div class="modal-header" style="border-bottom: 1px solid var(--border-color);">
                <h5 class="modal-title fw-bold" id="studentModalLabel">Add Student Profile</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" style="filter: var(--theme-close-btn-filter, invert(0.5)); outline: none; box-shadow: none;"></button>
            </div>
            <div class="modal-body p-4">
                <form id="studentForm" autocomplete="off">
                    <input type="hidden" id="hdnOldID" value="" />
                    
                    <div class="row g-3">
                        <!-- ID No & Name -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Admission ID No <span class="text-danger">*</span></label>
                            <input type="number" id="txtIDNo" class="form-input-modern" required placeholder="Unique numerical ID" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Student Name <span class="text-danger">*</span></label>
                            <input type="text" id="txtStudentName" class="form-input-modern" required placeholder="Full Name" />
                        </div>

                        <!-- Roll Numbers -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Class Roll No</label>
                            <input type="text" id="txtClassRollNo" class="form-input-modern" placeholder="e.g. CR-02" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">University Roll No</label>
                            <input type="text" id="txtUniRollNo" class="form-input-modern" placeholder="e.g. 1029482928" />
                        </div>

                        <!-- Course & Batch -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Course</label>
                            <input type="text" id="txtCourse" class="form-input-modern" placeholder="e.g. B.Tech CSE" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Batch</label>
                            <input type="text" id="txtBatch" class="form-input-modern" placeholder="e.g. 2022-2026" />
                        </div>

                        <!-- Father's Name & Email -->
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Father's Name</label>
                            <input type="text" id="txtFatherName" class="form-input-modern" placeholder="Father's Full Name" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label small fw-bold text-muted">Email Address</label>
                            <input type="email" id="txtEMailID" class="form-input-modern" placeholder="student@domain.com" />
                        </div>

                        <!-- Contact Numbers -->
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Phone No</label>
                            <input type="text" id="txtPhoneNo" class="form-input-modern" placeholder="Landline or Alternate" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Student Mobile</label>
                            <input type="text" id="txtStudentMobileNo" class="form-input-modern" placeholder="10-digit number" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label small fw-bold text-muted">Father Mobile</label>
                            <input type="text" id="txtFatherMobileNo" class="form-input-modern" placeholder="10-digit number" />
                        </div>

                        <!-- Permanent Address -->
                        <div class="col-12">
                            <label class="form-label small fw-bold text-muted">Permanent Address</label>
                            <textarea id="txtPermanentAddress" class="form-input-modern" rows="2" placeholder="Full permanent address details..."></textarea>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer" style="border-top: 1px solid var(--border-color);">
                <button type="button" class="btn btn-modern btn-secondary-modern" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-modern btn-primary-modern text-white" id="btnSaveStudent">
                    <i class="fas fa-save me-2"></i> Save Profile
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        let studentsList = [];

        $(document).ready(async function () {
            await loadColleges();

            // College dropdown change listener
            $('#ddlCollege').change(function () {
                const college = getSelectedCollege();
                if (!college) {
                    $('#btnSearch').prop('disabled', true);
                    $('#btnAdd').prop('disabled', true);
                    $('#btnExport').prop('disabled', true);
                    return;
                }
                $('#btnSearch').prop('disabled', false);
                $('#btnAdd').prop('disabled', false);
            });

            // Apply filter button
            $('#btnSearch').click(async function () {
                await loadStudents();
            });

            // Export Excel button
            $('#btnExport').click(function () {
                const college = getSelectedCollege();
                if (college) {
                    window.location.href = `/StudentSetting/ExportExcel?collegeName=${encodeURIComponent(college)}`;
                }
            });

            // Open Add modal
            $('#btnAdd').click(function () {
                openModalForAdd();
            });

            // Save/Update Modal Action
            $('#btnSaveStudent').click(async function () {
                await saveStudentProfile();
            });
        });

        // ================= GET SELECTIONS =================
        function getSelectedCollege() {
            return $('#ddlCollege').val();
        }

        // ================= DYNAMIC COLLEGE LOAD =================
        async function loadColleges() {
            try {
                const response = await fetch('/api/report/colleges');
                if (!response.ok) throw new Error("Failed to fetch colleges");
                
                const colleges = await response.json();
                const $ddl = $('#ddlCollege');
                $ddl.empty();

                if (colleges.length === 0) {
                    $ddl.append('<option value="">-- No Colleges Authorized --</option>');
                    return;
                }

                $ddl.append('<option value="">-- Select College --</option>');
                colleges.forEach(c => {
                    $ddl.append(`<option value="${c}">${c}</option>`);
                });

                // Auto-select if there is exactly 1 authorized college
                // if (colleges.length === 1) {
                //     $ddl.val(colleges[0]).trigger('change');
                // }
            } catch (err) {
                console.error("Colleges loading failed:", err);
                Swal.fire({
                    icon: 'error',
                    title: 'Retrieval Failed',
                    text: 'Failed to retrieve college profiles list from server.'
                });
            }
        }

        // ================= GET STUDENTS DIRECTORY =================
        async function loadStudents() {
            const college = getSelectedCollege();
            if (!college) return;

            showLoader();
            try {
                const response = await $.ajax({
                    url: '/StudentSetting/GetStudents',
                    type: 'GET',
                    data: { collegeName: college }
                });

                Swal.close();
                studentsList = response || [];
                renderStudents();
            } catch (err) {
                Swal.close();
                console.error("Failed to load students:", err);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Failed to retrieve student records from server.'
                });
                studentsList = [];
                renderStudents();
            }
        }

        // ================= RENDER TABLE & CARDS =================
        function renderStudents() {
            const $tbody = $('#tableBody');
            const $mobileContainer = $('#mobileCardsContainer');

            $tbody.empty();
            $mobileContainer.empty();

            const count = studentsList.length;
            $('#recordCountDisplay').text(`${count} Records Found`);

            if (count === 0) {
                $tbody.append(`
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div class="py-4">
                                <i class="fas fa-user-minus fa-2x mb-3 text-muted"></i>
                                <p class="mb-0 fw-semibold">No student records found in this institution.</p>
                            </div>
                        </td>
                    </tr>
                `);
                
                $mobileContainer.append(`
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-user-minus fa-2x mb-3 text-muted"></i>
                        <p class="mb-0">No student records found in this institution.</p>
                    </div>
                `);

                $('#btnExport').prop('disabled', true);
                return;
            }

            studentsList.forEach(student => {
                // Desktop row markup
                    $tbody.append(`
        <tr>
            <td class="ps-4 fw-medium text-primary">${student.idNo || '-'}</td>
            <td>${student.classRollNo || '-'}</td>
            <td>${student.uniRollNo || '-'}</td>
            <td class="fw-semibold text-primary">${student.studentName || '-'}</td>

            <td>${student.course || '-'}</td>  

            <td>${student.batch || '-'}</td>

            <td>${student.studentMobileNo || '-'}</td>

            <td>${student.eMailID || '-'}</td>

            <td class="pe-4 text-center">
                      <button class="btn btn-sm btn-outline-primary"
                style="border-radius:var(--radius-sm);"
                onclick="openModalForEdit(${student.idNo})">
            <i class="fas fa-pen"></i> Edit
        </button>
            </td>
        </tr>
        `);

                // Mobile card markup
                $mobileContainer.append(`
                    <div class="card mb-3 shadow-sm border-0" style="background: var(--bg-main); border-radius: var(--radius-md); border: 1px solid var(--border-color) !important;">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                                <span class="badge bg-primary-subtle text-primary fw-bold">ID: ${student.idNo}</span>
                                <span class="small text-muted fw-semibold">Roll: ${student.classRollNo || '-'}</span>
                            </div>
                            <h6 class="fw-bold mb-1 text-main">${student.studentName || '-'}</h6>
                            <p class="text-muted small mb-2"><i class="fas fa-graduation-cap me-1"></i> ${student.course || '-'} (${student.batch || '-'})</p>
                            <div class="small text-muted mb-2">
                                <i class="fas fa-map-marker-alt me-1"></i> ${student.permanentAddress || '-'}
                            </div>
                            <div class="d-flex justify-content-between pt-2 border-top small">
                                <span><i class="fas fa-phone me-1"></i> ${student.studentMobileNo || '-'}</span>
                                <span class="text-primary cursor-pointer" onclick="openModalForEdit(${student.idNo})">
                                    <i class="fas fa-pen me-1"></i> Edit Profile
                                </span>
                            </div>
                        </div>
                    </div>
                `);
            });

            $('#btnExport').prop('disabled', false);
        }

        // ================= MODAL STATE MANAGEMENT =================
        function openModalForAdd() {
            $('#studentModalLabel').text('Add Student Profile');
            $('#studentForm')[0].reset();
            $('#hdnOldID').val('');
            
            // Enable primary key IDNo input for new additions
            $('#txtIDNo').prop('readonly', false);
            
            $('#studentModal').modal('show');
        }

        function openModalForEdit(idNo) {
            const student = studentsList.find(s => s.idNo === idNo);
            if (!student) return;

            $('#studentModalLabel').text('Edit Student Profile');
            $('#hdnOldID').val(student.idNo);
            
            // Populate fields
            $('#txtIDNo').val(student.idNo).prop('readonly', true); // Keep key field read-only during edit for data safety
            $('#txtClassRollNo').val(student.classRollNo);
            $('#txtUniRollNo').val(student.uniRollNo);
            $('#txtStudentName').val(student.studentName);
            $('#txtCourse').val(student.course);
            $('#txtBatch').val(student.batch);
            $('#txtFatherName').val(student.fatherName);
            $('#txtPermanentAddress').val(student.permanentAddress);
            $('#txtPhoneNo').val(student.phoneNo);
            $('#txtStudentMobileNo').val(student.studentMobileNo);
            $('#txtFatherMobileNo').val(student.fatherMobileNo);
            $('#txtEMailID').val(student.eMailID);

            $('#studentModal').modal('show');
        }

        // ================= SAVE / UPDATE DATA =================
        async function saveStudentProfile() {
            const idNo = $('#txtIDNo').val();
            const studentName = $('#txtStudentName').val().trim();

            if (!idNo || !studentName) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Required Fields',
                    text: 'Admission ID No and Student Name are required.'
                });
                return;
            }

            const oldId = $('#hdnOldID').val();
            const isEdit = oldId !== '';

            // Construct student setting data DTO
            const dto = {
                CollegeName: getSelectedCollege(),
                IDNo: parseInt(idNo),
                ClassRollNo: $('#txtClassRollNo').val().trim(),
                UniRollNo: $('#txtUniRollNo').val().trim(),
                StudentName: studentName,
                Course: $('#txtCourse').val().trim(),
                Batch: $('#txtBatch').val().trim(),
                FatherName: $('#txtFatherName').val().trim(),
                PermanentAddress: $('#txtPermanentAddress').val().trim(),
                PhoneNo: $('#txtPhoneNo').val().trim(),
                StudentMobileNo: $('#txtStudentMobileNo').val().trim(),
                FatherMobileNo: $('#txtFatherMobileNo').val().trim(),
                EMailID: $('#txtEMailID').val().trim()
            };

            showLoader();
            try {
                const url = isEdit ? `/StudentSetting/UpdateStudent/${oldId}` : '/StudentSetting/AddStudent';
                const method = isEdit ? 'PUT' : 'POST';

                // NOTE: StudentSettingController does NOT have [FromBody], so we submit as form-urlencoded data
                const response = await $.ajax({
                    url: url,
                    type: method,
                    data: dto
                });

                Swal.close();

                // C# action returns bool (result)
                if (response === true) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Saved Successfully',
                        text: 'Student profile details have been saved.'
                    });
                    $('#studentModal').modal('hide');
                    await loadStudents();
                } else {
                    Swal.fire({
                        icon: 'error',
                        title: 'Operation Failed',
                        text: 'A record with this ID No may already exist, or save failed.'
                    });
                }
            } catch (err) {
                Swal.close();
                console.error("Save student error:", err);
                Swal.fire({
                    icon: 'error',
                    title: 'Request Failed',
                    text: 'An error occurred on the server while saving details.'
                });
            }
        }

        // ================= DYNAMIC SPINNER =================
        function showLoader() {
            Swal.fire({
                title: 'Processing Request...',
                text: 'Please Wait',
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
        }
    </script>
}
