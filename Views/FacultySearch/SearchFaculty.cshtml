@{
    ViewData["Title"] = "Faculty Name Search";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fade-in">
    <!-- Page Header -->
    <div class="page-header mt-2 mb-4 d-flex justify-content-between align-items-center">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-users-cog me-2 text-primary"></i>Faculty Name Search</h2>
            <p class="text-muted">Search and view complete details of active staff members or left employees by college.</p>
        </div>
    </div>

    <!-- Filter Section -->
    <div class="row mb-4">
        <div class="col-12">
            <div class="modern-card glass shadow-lg p-4" style="border-top: 4px solid var(--primary);">
                <form id="searchForm" novalidate onsubmit="event.preventDefault(); loadFacultySearch();">
                    <div class="row align-items-end g-3">
                        <div class="col-md-4">
                            <label for="collegeName" class="form-label small fw-bold text-muted mb-2">College Filter</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 input-group-text-modern">
                                    <i class="fas fa-university text-muted"></i>
                                </span>
                                <select id="collegeName" class="form-input-modern border-start-0" style="border-top-left-radius: 0; border-bottom-left-radius: 0;" required>
                                    <option value="">-- Select College --</option>
                                </select>
                                <div class="invalid-feedback">Please select a college.</div>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label for="facultyName" class="form-label small fw-bold text-muted mb-2">Faculty Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-end-0 input-group-text-modern">
                                    <i class="fas fa-user text-muted"></i>
                                </span>
                                <input type="text" id="facultyName" class="form-input-modern border-start-0" placeholder="Enter Faculty Name..." style="border-top-left-radius: 0; border-bottom-left-radius: 0;" />
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label small fw-bold text-muted mb-2">Search Type</label>
                            <div class="d-flex gap-3 align-items-center form-input-modern justify-content-start" style="height: 48px; border: 1px solid var(--border-color); border-radius: 8px; padding: 0 1rem; background: var(--bg-input);">
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="radio" name="searchType" id="typeActive" value="false" checked>
                                    <label class="form-check-label small fw-semibold text-main" for="typeActive">Active Staff</label>
                                </div>
                                <div class="form-check form-check-inline mb-0">
                                    <input class="form-check-input" type="radio" name="searchType" id="typeLeft" value="true">
                                    <label class="form-check-label small fw-semibold text-main" for="typeLeft">Employee Left</label>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-2 d-flex gap-2">
                            <button type="submit" id="btnSearch" class="btn btn-modern btn-primary-modern flex-grow-1" style="height: 48px;">
                                <i class="fas fa-search me-2" id="searchIcon"></i>
                                <span class="spinner-border spinner-border-sm me-2 d-none" id="searchSpinner" role="status" aria-hidden="true"></span>
                                Search
                            </button>
                            <button type="button" id="btnExport" class="btn btn-modern btn-success-modern d-none" onclick="exportToExcel()" style="height: 48px;" title="Export to Excel">
                                <i class="fas fa-file-excel"></i> Export
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- Stats Summary Row (Initially Hidden) -->
    <div class="row g-3 mb-4 d-none" id="statsRow">
        <div class="col-6 col-lg-6">
            <div class="modern-card text-center p-3 h-100" style="border-top: 4px solid var(--primary);">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="fas fa-users-cog"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.75rem;">Total Faculty Found</p>
                <h3 class="fw-bold text-primary mb-0" id="statTotal">0</h3>
            </div>
        </div>
        <div class="col-6 col-lg-6">
            <div class="modern-card text-center p-3 h-100" style="border-top: 4px solid var(--info);">
                <div class="bg-info bg-opacity-10 text-info rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px;">
                    <i class="fas fa-briefcase"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase mb-1" style="font-size: 0.75rem;">Unique Designations</p>
                <h3 class="fw-bold text-info mb-0" id="statDesignations">0</h3>
            </div>
        </div>
    </div>

    <!-- Results Section -->
    <div class="row">
        <div class="col-12">
            <div class="modern-card shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-main" id="resultsTitle">Search Results</h5>
                    <span class="badge bg-primary px-3 py-2" id="rowCount">0 Records</span>
                </div>

                <!-- Desktop/Tablet Table View -->
                <div class="table-responsive-modern d-none d-md-block" id="desktopView">
                    <table class="table custom-table mb-0">
                        <thead>
                            <tr>
                                <th>IDNo</th>
                                <th>Name</th>
                                <th>Designation</th>
                                <th>Father Name</th>
                                <th>Mobile No.</th>
                                <th>Permanent Address</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            <tr>
                                <td colspan="6" class="text-center py-5 text-muted">
                                    <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                                    <p class="mb-0">Enter search criteria to search faculty.</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="d-block d-md-none" id="mobileView">
                    <div id="mobileCardsContainer">
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                            <p class="mb-0">Enter search criteria to search faculty.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", async () => {
            await loadColleges();

            // Set up Enter key listener in search input
            const facultyNameInput = document.getElementById("facultyName");
            facultyNameInput.addEventListener("keypress", (e) => {
                if (e.key === "Enter") {
                    e.preventDefault();
                    loadFacultySearch();
                }
            });
        });

        // Load colleges for the dropdown
        async function loadColleges() {
            try {
                const response = await fetch('/api/report/colleges');
                if (!response.ok) throw new Error("Failed to load colleges");

                const colleges = await response.json();
                const ddl = document.getElementById("collegeName");
                ddl.innerHTML = '<option value="">-- Select College --</option>';

                colleges.forEach(college => {
                    const option = document.createElement("option");
                    option.value = college;
                    option.textContent = college;
                    ddl.appendChild(option);
                });
            } catch (error) {
                console.error(error);
                Swal.fire({
                    icon: 'error',
                    title: 'Error',
                    text: 'Unable to load colleges dropdown list.'
                });
            }
        }

        // Toggle search button loading state
        function setLoading(isLoading) {
            const btnSearch = document.getElementById("btnSearch");
            const searchIcon = document.getElementById("searchIcon");
            const searchSpinner = document.getElementById("searchSpinner");

            if (isLoading) {
                btnSearch.disabled = true;
                searchIcon.classList.add("d-none");
                searchSpinner.classList.remove("d-none");
            } else {
                btnSearch.disabled = false;
                searchIcon.classList.remove("d-none");
                searchSpinner.classList.add("d-none");
            }
        }

        // Fetch faculty search results
        async function loadFacultySearch() {
            const collegeName = document.getElementById("collegeName").value;
            const facultyName = document.getElementById("facultyName").value.trim();
            const isLeft = document.querySelector('input[name="searchType"]:checked').value;

            const form = document.getElementById("searchForm");
            if (!collegeName) {
                form.classList.add("was-validated");
                Swal.fire({
                    icon: 'warning',
                    title: 'Missing Fields',
                    text: 'Please select a College Name.'
                });
                return;
            }

            form.classList.remove("was-validated");
            setLoading(true);

            try {
                const url = `/FacultySearch/search?collegeName=${encodeURIComponent(collegeName)}&facultyName=${encodeURIComponent(facultyName)}&isLeft=${isLeft}`;
                const response = await fetch(url);
                
                if (!response.ok) {
                    const errorText = await response.text();
                    throw new Error(errorText || "Error searching faculty by name");
                }

                const result = await response.json();

                if (!result.success) {
                    Swal.fire({
                        icon: 'info',
                        title: 'No Records Found',
                        text: result.message || 'No faculty found matching the criteria.'
                    });
                    clearResults();
                    return;
                }

                const facultyList = result.data || [];

                // Render Results
                renderStats(facultyList);
                renderTable(facultyList);
                renderMobileCards(facultyList);
                
                // Show Stats and Export button
                document.getElementById("statsRow").classList.remove("d-none");
                document.getElementById("btnExport").classList.remove("d-none");
                document.getElementById("rowCount").innerText = `${facultyList.length} Records`;
                
                const tableLabel = isLeft === "true" ? "Resigned/Left Employees" : "Active Staff";
                document.getElementById("resultsTitle").innerText = `${tableLabel} in ${collegeName}`;

            } catch (error) {
                console.error(error);
                Swal.fire({
                    icon: 'error',
                    title: 'Search Failed',
                    text: error.message || 'An error occurred while searching faculty.'
                });
                clearResults();
            } finally {
                setLoading(false);
            }
        }

        // Reset elements
        function clearResults() {
            document.getElementById("statsRow").classList.add("d-none");
            document.getElementById("btnExport").classList.add("d-none");
            document.getElementById("rowCount").innerText = "0 Records";
            document.getElementById("resultsTitle").innerText = "Search Results";

            // Reset Desktop Table
            document.getElementById("tableBody").innerHTML = `
                <tr>
                    <td colspan="6" class="text-center py-5 text-muted">
                        <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                        <p class="mb-0">No records found.</p>
                    </td>
                </tr>
            `;

            // Reset Mobile Cards
            document.getElementById("mobileCardsContainer").innerHTML = `
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                    <p class="mb-0">No records found.</p>
                </div>
            `;
        }

        // Render Stats
        function renderStats(faculty) {
            const total = faculty.length;
            const designations = new Set(faculty.map(f => (f.designation || "").trim()).filter(d => d !== "")).size;

            document.getElementById("statTotal").innerText = total;
            document.getElementById("statDesignations").innerText = designations;
        }

        // Render Desktop Table
        function renderTable(faculty) {
            const tbody = document.getElementById("tableBody");
            tbody.innerHTML = "";

            if (faculty.length === 0) {
                tbody.innerHTML = `
                    <tr>
                        <td colspan="6" class="text-center py-5">No Records Found</td>
                    </tr>
                `;
                return;
            }

            faculty.forEach(f => {
                const tr = document.createElement("tr");
                tr.innerHTML = `
                    <td class="fw-semibold text-primary">${f.idNo || '-'}</td>
                    <td class="fw-semibold text-main">${f.name || '-'}</td>
                    <td>${f.designation || '-'}</td>
                    <td>${f.fatherName || '-'}</td>
                    <td><span class="text-muted"><i class="fas fa-phone me-1 text-primary small"></i>${f.mobileNo || '-'}</span></td>
                    <td style="max-width: 250px; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;" title="${f.permanentAddress || ''}">${f.permanentAddress || '-'}</td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Render Mobile Contact Cards
        function renderMobileCards(faculty) {
            const container = document.getElementById("mobileCardsContainer");
            container.innerHTML = "";

            if (faculty.length === 0) {
                container.innerHTML = `
                    <div class="text-center py-5 text-muted">
                        No Records Found
                    </div>
                `;
                return;
            }

            faculty.forEach(f => {
                const card = document.createElement("div");
                card.className = "modern-card mb-3 p-3 shadow-sm border-start border-4";
                card.style.borderLeftColor = "var(--primary)";
                
                card.innerHTML = `
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <div>
                            <h6 class="fw-bold mb-0 text-main">${f.name || '-'}</h6>
                            <small class="text-muted">${f.designation || '-'}</small>
                        </div>
                        <span class="badge bg-light text-dark border small">ID: ${f.idNo || '-'}</span>
                    </div>
                    
                    <div class="row g-2 pt-2 border-top mt-2 text-muted" style="font-size: 0.825rem;">
                        <div class="col-6">
                            <span class="text-muted small d-block">Father Name</span>
                            <span class="fw-semibold text-main">${f.fatherName || '-'}</span>
                        </div>
                        <div class="col-6">
                            <span class="text-muted small d-block">Mobile No.</span>
                            <span class="fw-semibold text-main"><i class="fas fa-phone-alt me-1 text-primary small"></i>${f.mobileNo || '-'}</span>
                        </div>
                        <div class="col-12 mt-1">
                            <span class="text-muted small d-block">Permanent Address</span>
                            <span class="fw-semibold text-main text-wrap">${f.permanentAddress || '-'}</span>
                        </div>
                    </div>
                `;
                container.appendChild(card);
            });
        }

        // Export data to Excel spreadsheet
        function exportToExcel() {
            const collegeName = document.getElementById("collegeName").value;
            const facultyName = document.getElementById("facultyName").value.trim();
            const isLeft = document.querySelector('input[name="searchType"]:checked').value;

            if (!collegeName) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Warning',
                    text: 'Select College Name first.'
                });
                return;
            }

            // Redirect to the Export endpoint
            window.location.href = `/FacultySearch/export?collegeName=${encodeURIComponent(collegeName)}&facultyName=${encodeURIComponent(facultyName)}&isLeft=${isLeft}`;
        }
    </script>
}
