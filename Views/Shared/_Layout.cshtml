@using Newtonsoft.Json
@using lib.DtoModel.LoginDto
@using Microsoft.AspNetCore.Http

@{
    var menuJson = Context.Session.GetString("MenuData");

    List<MenuItemResponse> menus = new();

    if (!string.IsNullOrEmpty(menuJson))
    {
        menus = JsonConvert.DeserializeObject<List<MenuItemResponse>>(menuJson);
    }
}

<body>

    <header>

        <nav class="navbar navbar-dark bg-dark px-3">

            <a class="navbar-brand text-white"
                   asp-controller="Home"
                   asp-action="Dashboard">

                Library Management

            </a>

            <div class="text-white">

                Welcome :
                @Context.Session.GetString("UserName")

            </div>

        </nav>

    </header>

    <div class="container-fluid">

        <div class="row">

            <!-- SIDEBAR -->

            <div class="col-md-2 bg-dark text-white min-vh-100 p-0">

                <div class="p-3">

                    <h5 class="text-warning">

                        MENU

                    </h5>

                    <hr />

                    @{
                        var menuJson =
                        Context.Session.GetString("MenuData");

                        List<lib.DtoModel.LoginDto.MenuItemResponse>
                        menus = new();

                        if (!string.IsNullOrEmpty(menuJson))
                        {
                            menus =
                            Newtonsoft.Json.JsonConvert
                            .DeserializeObject<List<lib.DtoModel.LoginDto.MenuItemResponse>>
                            (menuJson);
                        }
                    }

                    <ul class="nav flex-column">

                        @foreach (var item in menus)
                        {
                            <li class="nav-item mb-1">

                                <a class="nav-link text-white"
                                       href="/Home/MenuPage?func=@item.Func">

                                    @item.Text

                                </a>

                            </li>
                        }

                    </ul>

                </div>

            </div>

            <!-- MAIN CONTENT -->

            <div class="col-md-10 p-4">

                <main role="main">

                    @RenderBody()

                </main>

            </div>

        </div>

    </div>

    <footer class="border-top footer text-muted text-center p-2">

        © 2026 - Library Management System

    </footer>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

</body>