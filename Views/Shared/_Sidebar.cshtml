@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var currentAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<aside class="sidebar" id="appSidebar">
    <div class="sidebar-header">
        <div class="logo-icon">
            <i class="fas fa-book-reader fa-lg"></i>
        </div>
        <span class="logo-text">LibMaster Pro</span>
        <button class="mobile-close-sidebar" id="closeSidebar">
            <i class="fas fa-times"></i>
        </button>
    </div>

    <nav class="sidebar-menu">
        <!-- Dashboard -->
        <a asp-controller="Dashboard"
               asp-action="Index"
               class="menu-item">

            <div class="menu-icon">
                <i class="fas fa-th-large"></i>
            </div>

            <span>Dashboard</span>
        </a>
 
        <!-- Book Management Dropdown -->
        <div class="menu-dropdown">
            <button class="menu-dropdown-toggle" type="button" 
                    aria-expanded="@(currentController == "Books" || currentController == "AddStockRegister" ? "true" : "false")">
                <div class="menu-icon"><i class="fas fa-book"></i></div>
                <span>Stock</span>
                <i class="fas fa-chevron-right toggle-icon"></i>
            </button>
            <ul class="menu-sub @(currentController == "Books" || currentController == "AddStockRegister" ? "show" : "")">
                <li>
                    <a asp-controller="Books" asp-action="Index" 
                       class="menu-sub-item @((currentController == "Books" && currentAction == "Index") || currentController == "AddStockRegister" ? "active" : "")">
                        Add Books
                    </a>
                </li>
            </ul>
        </div>

        <!-- Student Management Dropdown -->
      @*   <div class="menu-dropdown">
            <button class="menu-dropdown-toggle" type="button" 
                    aria-expanded="@(currentController == "Students" ? "true" : "false")">
                <div class="menu-icon"><i class="fas fa-user-graduate"></i></div>
                <span>Student Management</span>
                <i class="fas fa-chevron-right toggle-icon"></i>
            </button>
            <ul class="menu-sub @(currentController == "Students" ? "show" : "")">
                <li>
                    <a asp-controller="Students" asp-action="Index" 
                       class="menu-sub-item @(currentController == "Students" && currentAction == "Index" ? "active" : "")">
                        All Students
                    </a>
                </li>
                <li>
                    <a asp-controller="Students" asp-action="Create" 
                       class="menu-sub-item @(currentController == "Students" && currentAction == "Create" ? "active" : "")">
                        Add Student
                    </a>
                </li>
            </ul>
        </div> *@

        <!-- Issue Book -->
        <a asp-controller="IssueBook" asp-action="Create" 
           class="menu-item @(currentController == "IssueBook" && currentAction == "Create" ? "active" : "")">
            <div class="menu-icon"><i class="fas fa-exchange-alt"></i></div>
            <span>Issue Book</span>
        </a>

        <!-- Return Book -->
        <a asp-controller="ReturnBook" asp-action="Index" 
           class="menu-item @(currentController == "ReturnBook" && currentAction == "Index" ? "active" : "")">
            <div class="menu-icon"><i class="fas fa-undo-alt"></i></div>
            <span>Return Book</span>
        </a>

        <!-- Renew Book -->
        <a asp-controller="RenewBook" asp-action="Index" 
           class="menu-item @(currentController == "RenewBook" && currentAction == "Index" ? "active" : "")">
            <div class="menu-icon"><i class="fas fa-sync-alt"></i></div>
            <span>Renew Book</span>
        </a>

        <!-- Status Dropdown -->
        <div class="menu-dropdown">
            <button class="menu-dropdown-toggle" type="button" 
                    aria-expanded="@(currentController == "Reports" ? "true" : "false")">
                <div class="menu-icon"><i class="bi bi-patch-check-fill"></i></i></div>
                <span>Status</span>
                <i class="fas fa-chevron-right toggle-icon"></i>
            </button>
            <ul class="menu-sub @(currentController == "Reports" ? "show" : "")">
                <li>
                    <a asp-controller="StockBook" asp-action="Index"
                           class="menu-sub-item @(currentController == "StockBook" && currentAction == "Index" ? "active" : "")">
                        Book Stock
                    </a>
                </li>
                <li>
                    <a asp-controller="Reports" asp-action="IssueReport" 
                       class="menu-sub-item @(currentController == "Reports" && currentAction == "IssueReport" ? "active" : "")">
                        Issue Report
                    </a>
                </li>
                <li>
                    <a asp-controller="ReferenceBook" asp-action="Index"
                           class="menu-sub-item @(currentController == "ReferenceBook" && currentAction == "Index" ? "active" : "")">
                        Reference Book
                    </a>
                </li>
                <li>
                    <a asp-controller="UnissuedBooks" asp-action="Index"
                           class="menu-sub-item @(currentController == "UnissuedBooks" && currentAction == "Index" ? "active" : "")">
                        Unissued Books
                    </a>
                </li>
                <li>
                    <a asp-controller="BookHistory" asp-action="Index"
                           class="menu-sub-item @(currentController == "BookHistory" && currentAction == "Index" ? "active" : "")">
                        Book History
                    </a>
                </li>
            </ul>
        </div>

        <!-- Search Dropdown -->
        <div class="menu-dropdown">
            <button class="menu-dropdown-toggle" type="button"
                    aria-expanded="@(currentController == "Search" || currentController == "PersonSearch" || currentController == "SearchDetailedAccession" || currentController == "SearchPersonId" || currentController == "SearchStudentName" || currentController == "FacultySearch" || currentController == "SearchIssueDates" || currentController == "SearchBookNo" || currentController == "SearchClassNo" || currentController == "SearchAccession" || currentController == "SearchMissingAccession" || currentController == "SearchISBN" ? "true" : "false")">

                <div class="menu-icon">
                    <i class="fas fa-search"></i>
                </div>

                <span>Search</span>

                <i class="fas fa-chevron-right toggle-icon"></i>
            </button>

            <ul class="menu-sub @(currentController == "Search" || currentController == "PersonSearch" || currentController == "SearchDetailedAccession" || currentController == "SearchPersonId" || currentController == "SearchStudentName" || currentController == "FacultySearch" || currentController == "SearchIssueDates" || currentController == "SearchBookNo" || currentController == "SearchClassNo" || currentController == "SearchAccession" || currentController == "SearchMissingAccession" || currentController == "SearchISBN" ? "show" : "")">
                <li>
                    <a asp-controller="PersonSearch" asp-action="Index"
                           class="menu-sub-item @(currentController == "PersonSearch" ? "active" : "")">
                        Person Id
                    </a>
                </li>
                <li>
                    <a asp-controller="SearchDetailedAccession" asp-action="Index"
                           class="menu-sub-item @(currentController == "SearchDetailedAccession" ? "active" : "")">
                        Detailed Accession No.
                    </a>
                </li>
                <li>
                    <a asp-controller="SearchPersonId" asp-action="Index"
                           class="menu-sub-item @(currentController == "SearchPersonId" ? "active" : "")">
                        Detailed Person ID
                    </a>
                </li>
                <li>
                    <a asp-controller="SearchStudentName" asp-action="Index"
                           class="menu-sub-item @(currentController == "SearchStudentName" ? "active" : "")">
                        Student Name
                    </a>
                </li>
                <li>
                    <a asp-controller="FacultySearch" asp-action="Index"
                           class="menu-sub-item @(currentController == "FacultySearch" ? "active" : "")">
                        Faculty Name
                    </a>
                </li>
                <li>
                    <a asp-controller="SearchIssueDates" asp-action="Index"
                           class="menu-sub-item @(currentController == "SearchIssueDates" ? "active" : "")">
                        Issue Dates
                    </a>
                </li>
                <li>
                    <a asp-controller="SearchBookNo" asp-action="Index"
                           class="menu-sub-item @(currentController == "SearchBookNo" ? "active" : "")">
                        Book No
                    </a>
                </li>
                <li>
                    <a asp-controller="SearchClassNo" asp-action="Index"
                           class="menu-sub-item @(currentController == "SearchClassNo" ? "active" : "")">
                        Class No
                    </a>
                </li>
                <li>
                    <a asp-controller="SearchAccession" asp-action="Index"
                           class="menu-sub-item @(currentController == "SearchAccession" ? "active" : "")">
                        Accession No
                    </a>
                </li>
                <li>
                    <a asp-controller="SearchMissingAccession" asp-action="Index"
                           class="menu-sub-item @(currentController == "SearchMissingAccession" ? "active" : "")">
                        Missing Accession No
                    </a>
                </li>
                <li>
                    <a asp-controller="SearchISBN" asp-action="Index"
                           class="menu-sub-item @(currentController == "SearchISBN" ? "active" : "")">
                        ISBN No
                    </a>
                </li>
            </ul>
          
        </div>
        <!-- Master Dropdown -->
        <div class="menu-dropdown">
            <button class="menu-dropdown-toggle" type="button"
                    aria-expanded="@(currentController == "Master" ? "true" : "false")">
                <div class="menu-icon"><i class="bi bi-database-fill"></i></div>
                <span>Master</span>
                <i class="fas fa-chevron-right toggle-icon"></i>
            </button>
            <ul class="menu-sub @(currentController == "MasterFine" ? "Index" : "")">
                <li>
                    <a asp-controller="MasterFine" asp-action="Index"
                           class="menu-sub-item @(currentController == "MasterFine" && currentAction == "Index" ? "active" : "")">
                        MasterFine
                    </a>
                </li>
                <li>
                    <a asp-controller="MasterIssueLimit" asp-action="Index"
                           class="menu-sub-item @(currentController == "MasterIssueLimit" && currentAction == "Index" ? "active" : "")">
                        Issue Limit
                    </a>
                </li>
            </ul>
        </div>


        <div class="menu-dropdown">
            <button class="menu-dropdown-toggle" type="button"
                    aria-expanded="@(currentController == "Reports" ? "true" : "false")">
                <div class="menu-icon"><i class="bi bi-file-earmark-text"></i></div>
                <span>Reports</span>
                <i class="fas fa-chevron-right toggle-icon"></i>
            </button>
            <ul class="menu-sub @(currentController == "Student" ? "Index" : "")">
                <li>
                    <a asp-controller="StudentReport" asp-action="Index"
                           class="menu-sub-item @(currentController == "StudentReport" && currentAction == "Index" ? "active" : "")">
                        Student
                    </a>
                </li>
                <li>
                    <a asp-controller="StaffReport" asp-action="Index"
                           class="menu-sub-item @(currentController == "StaffReport" && currentAction == "Index" ? "active" : "")">
                        Staff
                    </a>
                </li>
            </ul>
        </div>

        <div class="menu-dropdown">
            <button class="menu-dropdown-toggle" type="button"
                    aria-expanded="@(currentController == "Setting" ? "true" : "false")">
                <div class="menu-icon"><i class="bi bi-gear"></i></div>
                <span>Setting</span>
                <i class="fas fa-chevron-right toggle-icon"></i>
            </button>
            <ul class="menu-sub @(currentController == "Setting" ? "Index" : "")">
                <li>
                    <a asp-controller="StudentSetting" asp-action="Index"
                           class="menu-sub-item @(currentController == "StudentSetting" && currentAction == "Index" ? "active" : "")">
                        Student
                    </a>
                </li>
                <li>
                    <a asp-controller="TeacherSetting" asp-action="Index"
                           class="menu-sub-item @(currentController == "TeacherSetting" && currentAction == "Index" ? "active" : "")">
