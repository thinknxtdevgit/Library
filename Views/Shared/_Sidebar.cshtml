        <!-- Settings -->

       @*  <a asp-controller="Settings" asp-action="Index" 
           class="menu-item @(currentController == "Settings" && currentAction == "Index" ? "active" : "")">
            <div class="menu-icon"><i class="fas fa-cog"></i></div>
            <span>Settings</span>
        </a> *@
