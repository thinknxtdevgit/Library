@{
    ViewData["Title"] = "Staff Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Print-Only Header Block -->
<div class="d-none d-print-block print-header" id="printReportHeader">

    <div class="text-center">

        <h2 id="printCollegeName"></h2>

        <p id="printAddress1"></p>
        <p id="printAddress2"></p>

        <h3>Staff Report</h3>

        <div class="print-info">
            <span>
                Generated :
                @DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt")
            </span>

            <span id="printRecordCount">
                0 Records
            </span>
        </div>

    </div>

</div>

<div class="fade-in d-print-none">
    <!-- Page Header -->
    <div class="page-header mt-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="fas fa-id-card text-primary me-2"></i>Staff Report
            </h2>
            <p class="text-muted">Generate, view, print, and export detailed staff directory information filtered by institution.</p>
        </div>
        <div class="d-flex gap-2 w-100-mobile">
            <button class="btn btn-modern btn-secondary-modern btn-auto-width" id="btnPrint" disabled style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); color: white; box-shadow: 0 4px 14px rgba(59, 130, 246, 0.3);">
                <i class="fas fa-print me-2"></i> Print Report
            </button>
            <button class="btn btn-modern btn-success-modern btn-auto-width text-white" id="btnExport" style="background: linear-gradient(135deg, var(--success) 0%, #15803d 100%); box-shadow: 0 4px 14px rgba(34, 197, 94, 0.3);" disabled>
                <i class="fas fa-file-excel me-2"></i> Export Excel
            </button>
        </div>
    </div>

    <!-- Filters Panel -->
    <div class="modern-card mb-4 glass border-0">
        <div class="row g-3 align-items-end">
            <!-- College Selector -->
            <div class="col-lg-9 col-md-8">
                <label class="form-label small fw-bold text-muted mb-2">College</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-top-left-radius: var(--radius-md); border-bottom-left-radius: var(--radius-md); border-color: var(--border-color);">
                        <i class="fas fa-university text-muted"></i>
                    </span>
                    <select id="ddlCollege" class="form-input-modern" style="border-top-left-radius:0; border-bottom-left-radius:0;">
                        <option value="">-- Loading Colleges... --</option>
                    </select>
                </div>
            </div>

            <!-- Search Action Button -->
            <div class="col-lg-3 col-md-4">
                <button class="btn btn-modern btn-primary-modern w-100 py-2 text-white" id="btnSearch" disabled>
                    <i class="fas fa-search me-2"></i> Apply Filter
                </button>
            </div>
        </div>
    </div>

    <!-- Results Display Panel -->
    <div class="row">
        <div class="col-12">
            <div class="modern-card shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-main" id="resultsTitle">Staff Report</h5>
                    <span class="badge badge-modern badge-modern-primary" id="recordCountDisplay">0 Records Found</span>
                </div>

                <!-- Desktop/Tablet Table View -->
                <div class="table-responsive-modern d-none d-md-block" id="desktopView">
                    <table class="table custom-table mb-0" id="resultsTable">
                        <thead>
                            <tr>
                                <th class="ps-4">ID No</th>
                                <th>Staff Name</th>
                                <th>Designation</th>
                                <th>Department</th>
                                <th>Permanent Address</th>
                                <th style="width:100px;">Contact No</th>
                                <th style="width:100px;">Mobile No</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                                    <p class="mb-0">Select college filters and click Apply Filter to display staff data.</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="d-block d-md-none" id="mobileView">
                    <div id="mobileCardsContainer">
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                            <p class="mb-0">Select college filters and click Apply Filter to display staff data.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Print Stylesheet -->
<style>
    @@media print {

        @@page {
            size: A4 portrait;
            margin: 12mm;
        }

        body {
            background: #fff !important;
            font-family: Arial,sans-serif;
            font-size: 12px;
        }

        .sidebar,
        .top-navbar,
        .page-header,
        .modern-card,
        .btn,
        footer {
            display: none !important;
        }

        #printReportHeader {
            display: block !important;
        }

        .print-header h2 {
            font-size: 22px;
            margin-bottom: 5px;
            font-weight: bold;
        }

        .print-header p {
            margin: 2px;
            font-size: 13px;
        }

        .print-header h3 {
            margin-top: 12px;
            font-size: 18px;
            border-bottom: 2px solid #000;
            padding-bottom: 5px;
        }

        .print-info {
            display: flex;
            justify-content: space-between;
            margin-top: 10px;
            border-bottom: 1px solid #000;
            padding-bottom: 5px;
            font-size: 12px;
        }

        #printTableWrapper {
            display: block !important;
            margin-top: 15px;
        }

        .print-custom-table {
            width: 100%;
            border-collapse: collapse;
            table-layout: fixed;
            font-size: 11px;
        }

            .print-custom-table th {
                background: #eee !important;
                color: #000;
                font-weight: bold;
                text-align: center;
            }

            .print-custom-table th,
            .print-custom-table td {
                border: 1px solid #000;
                padding: 5px;
                vertical-align: top;
                word-wrap: break-word;
            }

        thead {
            display: table-header-group;
        }

        tr {
            page-break-inside: avoid;
        }

        .print-footer {
            position: fixed;
            bottom: 0;
            left: 0;
            width: 100%;
            border-top: 1px solid #999;
            padding-top: 5px;
            font-size: 10px;
            display: flex;
            justify-content: space-between;
        }
    }
</style>

<!-- Hidden print helper container to render native tables at print-time -->
<div id="printTableWrapper" style="display:none;">
    <table class="print-custom-table">

        <thead>

            <tr>

                <th style="width:10%">ID No</th>
                <th style="width:20%">Staff Name</th>
                <th style="width:15%">Designation</th>
                <th style="width:15%">Department</th>
                <th style="width:25%">Permanent Address</th>
                <th style="width:7%">Contact</th>
                <th style="width:8%">Mobile</th>

            </tr>

        </thead>

        <tbody id="printTableBody"></tbody>

    </table>
</div>
<div class="d-none d-print-block print-footer">

    <span>
        Library Management System
    </span>

    <span>
        Page <span class="pageNumber"></span>
    </span>

</div>

@section Scripts {
    <script>
           let searchResults = [];
            let reportData = {};
        $(document).ready(async function () {
            await loadColleges();

            // College selector dropdown change handler
            $('#ddlCollege').change(function () {
                const college = getSelectedCollege();
                if (!college) {
                    $('#btnSearch').prop('disabled', true);
                    return;
                }
                $('#btnSearch').prop('disabled', false);
            });

            // Trigger Search
            $('#btnSearch').click(async function () {
                await executeSearch();
            });

            // Export to Excel (CSV download)
            $('#btnExport').click(function () {
                exportToExcel();
            });

            // Print Action
            $('#btnPrint').click(function () {
                triggerPrint();
            });
        });

        // ================= GET SELECTED VALUE =================
        function getSelectedCollege() {
            return $('#ddlCollege').val();
        }

        // ================= DYNAMIC COLLEGE LOAD =================
        async function loadColleges() {
            try {
                // Fetch authorized colleges from the standard session colleges api
                const response = await fetch('/api/report/colleges');
                if (!response.ok) throw new Error("Failed to fetch colleges");
                
                const colleges = await response.json();
                const $ddl = $('#ddlCollege');
                $ddl.empty();

                if (colleges.length === 0) {
                    $ddl.append('<option value="">-- No Colleges Authorized --</option>');
                    $('#btnSearch').prop('disabled', true);
                    return;
                }

                $ddl.append('<option value="">-- Select College --</option>');
                colleges.forEach(c => {
                    $ddl.append(`<option value="${c}">${c}</option>`);
                });

                // Auto-select if there is exactly 1 authorized college
                if (colleges.length === 1) {
                    $ddl.val(colleges[0]).trigger('change');
                }
            } catch (err) {
                console.error("Colleges loading failed:", err);
                Swal.fire({
                    icon: 'error',
                    title: 'Retrieval Failed',
                    text: 'Failed to retrieve college profiles list from server.'
                });
            }
        }

        // ================= SEARCH IMPLEMENTATION =================
        async function executeSearch() {
            const college = getSelectedCollege();

            if (!college) {
                Swal.fire({
                    icon: 'warning',
                    title: 'College Required',
                    text: 'Please select a college name to perform search.'
                });
                return;
            }

            showLoader();
            try {
                const response = await $.ajax({
                    url: '/StaffReport/Search',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        CollegeName: college
                    })
                });

                Swal.close();
                // Response matches StaffReportResponseDto which has StaffList
                reportData = response;
                searchResults = response.staffList || [];
                renderResults();
            } catch (err) {
                Swal.close();
                console.error("Search request failed:", err);
                const errorMsg = err.status === 404 ? "No record found for Print" : "A network or server error occurred while retrieving report results.";
                Swal.fire({
                    icon: err.status === 404 ? 'info' : 'error',
                    title: err.status === 404 ? 'No Records' : 'Search Failed',
                    text: errorMsg
                });
                // Reset state
                searchResults = [];
                renderResults();
            }
        }

        // ================= RENDERING =================
        function renderResults() {
            const $tbody = $('#tableBody');
            const $mobileContainer = $('#mobileCardsContainer');
            
            $tbody.empty();
            $mobileContainer.empty();

            const count = searchResults.length;
            $('#recordCountDisplay').text(`${count} Records Found`);
            
            // Set values for print header
                if (reportData) {

                    $("#printCollegeName").text(reportData.collegeName || "");

                    $("#printAddress1").text(reportData.address1 || "");

                    $("#printAddress2").text(reportData.address2 || "");

                    $("#printRecordCount").text((reportData.totalRecords || 0) + " Records Found");
                }

            if (count === 0) {
                $tbody.append(`
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <div class="py-4">
                                <i class="fas fa-search-minus fa-2x mb-3 text-muted"></i>
                                <p class="mb-0 fw-semibold">No staff records found matching the selected criteria.</p>
                            </div>
                        </td>
                    </tr>
                `);
                
                $mobileContainer.append(`
                    <div class="text-center py-5 text-muted">
                        <i class="fas fa-search-minus fa-2x mb-3 text-muted"></i>
                        <p class="mb-0">No staff records found matching the selected criteria.</p>
                    </div>
                `);

                $('#btnExport').prop('disabled', true);
                $('#btnPrint').prop('disabled', true);
                return;
            }

            // Render Table (Desktop) & Cards (Mobile)
            searchResults.forEach(staff => {
                // Desktop row
                $tbody.append(`
                    <tr>
                        <td class="ps-4 fw-medium text-primary">${staff.idNo || '-'}</td>
                        <td class="fw-semibold">${staff.name || '-'}</td>
                        <td>${staff.designation || '-'}</td>
                        <td>${staff.department || '-'}</td>
                        <td class="small text-wrap text-muted" style="max-width: 250px;">${staff.permanentAddress || '-'}</td>
                        <td>${staff.contactNo || '-'}</td>
                        <td class="pe-4">${staff.mobileNo || '-'}</td>
                    </tr>
                `);

                // Mobile card
                $mobileContainer.append(`
                    <div class="card mb-3 shadow-sm border-0" style="background: var(--bg-main); border-radius: var(--radius-md); border: 1px solid var(--border-color) !important;">
                        <div class="card-body p-3">
                            <div class="d-flex justify-content-between align-items-center border-bottom pb-2 mb-2">
                                <span class="badge bg-primary-subtle text-primary fw-bold">${staff.idNo || '-'}</span>
                                <span class="small text-muted fw-medium">${staff.department || '-'}</span>
                            </div>
                            <h6 class="fw-bold mb-1 text-main">${staff.name || '-'}</h6>
                            <p class="text-muted small mb-2"><i class="fas fa-briefcase me-1"></i> ${staff.designation || '-'}</p>
                            <div class="small text-muted mb-2">
                                <i class="fas fa-map-marker-alt me-1"></i> ${staff.permanentAddress || '-'}
                            </div>
                            <div class="d-flex justify-content-between pt-2 border-top small">
                                <span><i class="fas fa-phone me-1"></i> ${staff.contactNo || '-'}</span>
                                <span><i class="fas fa-mobile-alt me-1"></i> ${staff.mobileNo || '-'}</span>
                            </div>
                        </div>
                    </div>
                `);
            });

            $('#btnExport').prop('disabled', false);
            $('#btnPrint').prop('disabled', false);
        }

        // ================= EXPORT EXCEL (CSV DOWNLOAD) =================
        function exportToExcel() {
            if (searchResults.length === 0) return;

            let csvContent = "\uFEFF"; // UTF-8 BOM
            const headers = ["ID No", "Staff Name", "Designation", "Department", "Permanent Address", "Contact No", "Mobile No"];
            csvContent += headers.map(h => `"${h}"`).join(",") + "\r\n";
            
            searchResults.forEach(row => {
                const values = [
                    row.idNo || "",
                    row.name || "",
                    row.designation || "",
                    row.department || "",
                    row.permanentAddress || "",
                    row.contactNo || "",
                    row.mobileNo || ""
                ].map(val => `"${val.toString().replace(/"/g, '""')}"`);
                csvContent += values.join(",") + "\r\n";
            });

            const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.href = url;
            
            const college = getSelectedCollege();
            const fileName = `StaffReport_${college.replace(/[^a-z0-9]/gi, '_')}.csv`;
            
            link.setAttribute("download", fileName);
            document.body.appendChild(link);
            link.click();
            document.body.removeChild(link);
        }

        // ================= PRINTING LAYOUT POPULATION =================
         function triggerPrint() {

                    if (searchResults.length == 0)
                        return;

                    $("#printCollegeName").text(reportData.collegeName || "");

                    $("#printAddress1").text(reportData.address1 || "");

                    $("#printAddress2").text(reportData.address2 || "");

                    $("#printRecordCount").text((reportData.totalRecords || 0) + " Records Found");

                    let body = $("#printTableBody");

                    body.empty();

            searchResults.forEach(staff => {

               body.append(`
                  <tr>
                      <td>${staff.idNo ?? ""}</td>
                       <td>${staff.name ?? ""}</td>
                       <td>${staff.designation ?? ""}</td>
                      <td>${staff.department ?? ""}</td>
                      <td>${staff.permanentAddress ?? ""}</td>
                       <td>${staff.contactNo ?? ""}</td>
                       <td>${staff.mobileNo ?? ""}</td>
                    </tr>
               `);

            });

                    $("#printTableWrapper").show();

                    window.print();

                    $("#printTableWrapper").hide();
                }
        // ================= DYNAMIC SPINNER =================
        function showLoader() {
            Swal.fire({
                title: 'Loading Data...',
                text: 'Please Wait',
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
        }
    </script>
}
