@{
    ViewData["Title"] = "Unissued Books Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fade-in">

    <!-- HEADER -->
    <div class="page-header mt-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Unissued Books Report</h2>
            <p class="text-muted">
                Analyze library books that have never been issued or are currently in stock.
            </p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-modern btn-primary-modern text-white"
                    style="background: linear-gradient(135deg, #22c55e, #15803d);"
                    onclick="exportExcel()">
                <i class="fas fa-file-excel me-2"></i> Export Excel
            </button>
        </div>
    </div>

    <!-- FILTER CARD -->
    <div class="modern-card mb-4 glass border-0">
        <div class="row g-3 align-items-end">

            <div class="col-md-5">
                <label class="form-label small fw-bold text-muted">College Filter</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0">
                        <i class="fas fa-university text-muted"></i>
                    </span>
                    <select id="collegeName" class="form-input-modern">
                        <option value="">-- Select College --</option>
                    </select>
                </div>
            </div>

            <div class="col-md-3">
                <button class="btn btn-modern btn-primary-modern w-100 text-white"
                        onclick="loadReport(1)">
                    <i class="fas fa-filter me-2"></i> Apply Filter
                </button>
            </div>

            <div class="col-md-4 text-end d-none d-md-block">
                <div class="text-muted small">
                    Showing: <span class="fw-bold text-primary" id="currentFilter">Global Unissued Stock</span>
                </div>
            </div>

        </div>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="modern-card text-center bg-white"
                 style="border-top: 4px solid var(--primary);">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="width:50px;height:50px;">
                    <i class="fas fa-book fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase">Total Books</p>
                <h2 class="fw-bold text-primary" id="totalBooks">0</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="modern-card text-center bg-white"
                 style="border-top: 4px solid var(--warning);">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="width:50px;height:50px;">
                    <i class="fas fa-layer-group fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase">Total Titles</p>
                <h2 class="fw-bold text-warning" id="totalTitles">0</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="modern-card text-center bg-white"
                 style="border-top: 4px solid var(--success);">
                <div class="bg-success bg-opacity-10 text-success rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="width:50px;height:50px;">
                    <i class="fas fa-check-circle fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase">Available Copies</p>
                <h2 class="fw-bold text-success" id="availableBooks">0</h2>
            </div>
        </div>

    </div>

    <!-- TABLE -->
    <div class="modern-card">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Unissued Details</h5>
            <div class="small badge bg-primary" id="rowCount">0 Records</div>
        </div>

        <div class="table-responsive-modern">
            <table class="table custom-table" id="stockTable">

                <thead id="tableHead"></thead>

                <tbody id="tableBody">
                    <tr>
                        <td class="text-center py-5 text-muted">
                            <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                            <p>Apply filter to load unissued data</p>
                        </td>
                    </tr>
                </tbody>
                
            </table>
        </div>
        <!-- PAGINATION -->
        <div id="pagination" class="mt-3 d-flex justify-content-center gap-2"></div>

    </div>

</div>

@section Scripts {

    <script>

        let currentPage = 1;
        const pageSize = 10;
        let totalPages = 1;

        // ================= INIT =================
        document.addEventListener("DOMContentLoaded", async () => {
            await loadColleges();
        });

        // ================= SWEET ALERT =================
        function showLoader() {
            Swal.fire({
                title: 'Loading...',
                text: 'Please wait',
                allowOutsideClick: false,
                allowEscapeKey: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
        }

        function hideLoader() {
            if (Swal.isVisible()) {
                Swal.close();
            }
        }

        function showWarning(message) {
            Swal.fire({
                icon: 'warning',
                title: 'Warning',
                text: message
            });
        }

        function showError(message) {
            Swal.fire({
                icon: 'error',
                title: 'Error',
                text: message
            });
        }

        // ================= LOAD COLLEGES =================
        async function loadColleges() {
            try {

                const response = await fetch('/api/report/colleges');

                if (!response.ok)
                    throw new Error("Failed to load colleges");

                const colleges = await response.json();

                const ddl = document.getElementById("collegeName");

                ddl.innerHTML =
                    '<option value="">-- Select College --</option>' +
                    colleges.map(c =>
                        `<option value="${c}">${c}</option>`
                    ).join('');

            }
            catch (err) {
                console.error(err);
                showError("Unable to load colleges.");
            }
        }

        // ================= LOAD REPORT =================
        async function loadReport(page = 1) {

            const collegeName =
                document.getElementById("collegeName").value;

            if (!collegeName) {
                showWarning("Please select a college.");
                return;
            }

            currentPage = page;

            try {

                showLoader();

                const response = await fetch(
                    '/UnissuedBooks/GetUnissuedBooksPaged',
                    {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json'
                        },
                        body: JSON.stringify({
                            search: collegeName,
                            pageNumber: currentPage,
                            pageSize: pageSize
                        })
                    });

                if (!response.ok) {

                    const errorText = await response.text();

                    console.error(errorText);

                    throw new Error(
                        `Server Error (${response.status})`
                    );
                }

                const result = await response.json();

                updateSummary(result, collegeName);

                renderTable(result.data || []);

                totalPages = Math.max(
                    1,
                    Math.ceil(result.totalRecords / pageSize)
                );

                renderPagination();
            }
            catch (err) {

                console.error(err);

                showError(
                    err.message || "Failed to load report."
                );
            }
            finally {

                // Loader ALWAYS close
                hideLoader();
            }
        }

        // ================= SUMMARY =================
        function updateSummary(result, collegeName) {

            document.getElementById("currentFilter").innerText =
                collegeName;

            document.getElementById("rowCount").innerText =
                `${result.totalRecords || 0} Records`;

            document.getElementById("totalBooks").innerText =
                result.totalRecords || 0;

            document.getElementById("availableBooks").innerText =
                result.totalRecords || 0;

            // Unique title count if API returns it
            document.getElementById("totalTitles").innerText =
                result.totalTitles || result.totalRecords || 0;
        }

        // ================= TABLE =================
        function renderTable(data) {

            const tableHead =
                document.getElementById("tableHead");

            const tableBody =
                document.getElementById("tableBody");

            tableHead.innerHTML = "";
            tableBody.innerHTML = "";

            if (!data.length) {

                tableBody.innerHTML = `
                    <tr>
                        <td class="text-center py-4">
                            No Data Found
                        </td>
                    </tr>`;

                return;
            }

            const keys = Object.keys(data[0]);

            tableHead.innerHTML = `
                <tr>
                    ${keys.map(k => `<th>${k}</th>`).join("")}
                </tr>`;

            tableBody.innerHTML = data.map(row => `
                <tr>
                    ${keys.map(k => {

                        let value = row[k];

                        if (value === null || value === undefined)
                            value = "-";

                        if (
                            k.toLowerCase().includes("date") &&
                            value !== "-"
                        ) {
                            value = new Date(value)
                                .toLocaleDateString("en-IN");
                        }

                        return `<td>${value}</td>`;

                    }).join("")}
                </tr>
            `).join("");
        }

        // ================= PAGINATION =================
        function renderPagination() {

            document.getElementById("pagination").innerHTML = `
                <button
                    class="btn btn-sm btn-primary"
                    ${currentPage === 1 ? "disabled" : ""}
                    onclick="loadReport(${currentPage - 1})">
                    Prev
                </button>

                <span class="px-3 align-self-center">
                    Page ${currentPage} of ${totalPages}
                </span>

                <button
                    class="btn btn-sm btn-primary"
                    ${currentPage >= totalPages ? "disabled" : ""}
                    onclick="loadReport(${currentPage + 1})">
                    Next
                </button>
            `;
        }

        // ================= EXPORT =================
        function exportExcel() {

            const collegeName =
                document.getElementById("collegeName").value;

            if (!collegeName) {
                showWarning("Please select a college.");
                return;
            }

            window.location.href =
                `/UnissuedBooks/ExportExcel?collegeName=${encodeURIComponent(collegeName)}`;
        }

    </script>
}
