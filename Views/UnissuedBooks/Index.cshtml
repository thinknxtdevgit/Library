@{
    ViewData["Title"] = "Unissued Books Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="fade-in">

    <!-- HEADER -->
    <div class="page-header mt-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">Unissued Books Report</h2>
            <p class="text-muted">
                Analyze library books that have never been issued or are currently in stock.
            </p>
        </div>

        <div class="d-flex gap-2">
            <button class="btn btn-modern btn-primary-modern text-white"
                    style="background: linear-gradient(135deg, #22c55e, #15803d);"
                    onclick="exportExcel()">
                <i class="fas fa-file-excel me-2"></i> Export Excel
            </button>
        </div>
    </div>

    <!-- FILTER CARD -->
    <div class="modern-card mb-4 glass border-0">
        <div class="row g-3 align-items-end">

            <div class="col-md-5">
                <label class="form-label small fw-bold text-muted">College Filter</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0">
                        <i class="fas fa-university text-muted"></i>
                    </span>
                    <select id="collegeName" class="form-input-modern">
                        <option value="">-- Select College --</option>
                    </select>
                </div>
            </div>

            <div class="col-md-3">
                <button class="btn btn-modern btn-primary-modern w-100 text-white"
                        onclick="loadReport()">
                    <i class="fas fa-filter me-2"></i> Apply Filter
                </button>
            </div>

            <div class="col-md-4 text-end d-none d-md-block">
                <div class="text-muted small">
                    Showing: <span class="fw-bold text-primary" id="currentFilter">Global Unissued Stock</span>
                </div>
            </div>

        </div>
    </div>

    <!-- SUMMARY CARDS -->
    <div class="row g-4 mb-4">

        <div class="col-md-4">
            <div class="modern-card text-center bg-white"
                 style="border-top: 4px solid var(--primary);">
                <div class="bg-primary bg-opacity-10 text-primary rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="width:50px;height:50px;">
                    <i class="fas fa-book fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase">Total Books</p>
                <h2 class="fw-bold text-primary" id="totalBooks">0</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="modern-card text-center bg-white"
                 style="border-top: 4px solid var(--warning);">
                <div class="bg-warning bg-opacity-10 text-warning rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="width:50px;height:50px;">
                    <i class="fas fa-layer-group fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase">Total Titles</p>
                <h2 class="fw-bold text-warning" id="totalTitles">0</h2>
            </div>
        </div>

        <div class="col-md-4">
            <div class="modern-card text-center bg-white"
                 style="border-top: 4px solid var(--success);">
                <div class="bg-success bg-opacity-10 text-success rounded-circle mx-auto mb-3 d-flex align-items-center justify-content-center"
                     style="width:50px;height:50px;">
                    <i class="fas fa-check-circle fa-lg"></i>
                </div>
                <p class="text-muted small fw-bold text-uppercase">Available Copies</p>
                <h2 class="fw-bold text-success" id="availableBooks">0</h2>
            </div>
        </div>

    </div>

    <!-- TABLE -->
    <div class="modern-card">

        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0">Unissued Details</h5>
            <div class="small badge bg-primary" id="rowCount">0 Records</div>
        </div>

        <div class="table-responsive-modern">
            <table class="table custom-table" id="stockTable">

                <thead id="tableHead"></thead>

                <tbody id="tableBody">
                    <tr>
                        <td class="text-center py-5 text-muted">
                            <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                            <p>Apply filter to load unissued data</p>
                        </td>
                    </tr>
                </tbody>
                
            </table>
        </div>
        <!-- PAGINATION -->
        <div id="pagination" class="mt-3 d-flex justify-content-center gap-2"></div>

    </div>

</div>

@section Scripts {

    <script>

        let allBooks = [];
        let currentPage = 1;
        let pageSize = 20;
        let totalPages = 0;

        // ================= INIT =================
        document.addEventListener("DOMContentLoaded", () => {
            loadColleges();
            loadReport(1); // optional auto load
        });

        // ================= COLLEGES =================
        async function loadColleges() {
            const res = await fetch('/api/report/colleges');
            const data = await res.json();

            let ddl = document.getElementById("collegeName");
            ddl.innerHTML = `<option value="">-- Select College --</option>`;

            data.forEach(x => {
                ddl.innerHTML += `<option value="${x}">${x}</option>`;
            });
        }

        // ================= LOAD REPORT =================
        async function loadReport(page = 1) {

            currentPage = page;

            const collegeName = document.getElementById("collegeName").value;

            if (!collegeName) {
                // If auto-loading on startup, fail silently
                if (page === 1 && !document.getElementById("collegeName").dataset.loadedOnce) {
                    return;
                }
                Swal.fire({ icon: 'warning', title: 'College Required' });
                return;
            }
            document.getElementById("collegeName").dataset.loadedOnce = "true";

            // If we already loaded data and only page changes, don't refetch
            if (allBooks.length > 0 && allBooks[0].collegeName === collegeName) {
                renderReportData();
                return;
            }

            // Show loading
            document.getElementById("tableBody").innerHTML = `
                <tr>
                    <td class="text-center py-5 text-muted">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Loading...</span>
                        </div>
                    </td>
                </tr>
            `;

            try {
                const res = await fetch(`/UnissuedBooks/get?collegeName=${encodeURIComponent(collegeName)}`);
                const result = await res.json();

                allBooks = result || [];
                allBooks.forEach(b => b.collegeName = collegeName);

                // Calculate summary
                const totalBooks = allBooks.length;
                const uniqueTitles = new Set(allBooks.map(b => (b.title || '').trim().toLowerCase())).size;

                document.getElementById("totalBooks").innerText = totalBooks;
                document.getElementById("totalTitles").innerText = uniqueTitles;
                document.getElementById("availableBooks").innerText = totalBooks;
                document.getElementById("currentFilter").innerText = collegeName;

                renderReportData();
            } catch (err) {
                console.error(err);
                document.getElementById("tableBody").innerHTML = `<tr><td class="text-center py-4 text-danger">Failed to load data</td></tr>`;
            }
        }

        function renderReportData() {
            const totalRecords = allBooks.length;
            document.getElementById("rowCount").innerText = totalRecords + " Records";

            totalPages = Math.ceil(totalRecords / pageSize);

            if (totalPages === 0) totalPages = 1;

            const pagedData = allBooks.slice((currentPage - 1) * pageSize, currentPage * pageSize);
            renderTable(pagedData);

            renderPagination();
        }

        // ================= TABLE =================
        function renderTable(data) {

            const head = document.getElementById("tableHead");
            const body = document.getElementById("tableBody");

            head.innerHTML = "";
            body.innerHTML = "";

            if (!data || data.length === 0) {
                body.innerHTML = `<tr><td class="text-center py-4">No Data Found</td></tr>`;
                return;
            }

            const keys = Object.keys(data[0]);

            let h = "<tr>";
            keys.forEach(k => {
                if (k === "collegeName") return;
                h += `<th>${k}</th>`;
            });
            h += "</tr>";

            head.innerHTML = h;

            let rows = "";

            data.forEach(row => {
                rows += "<tr>";
                keys.forEach(k => {
                    if (k === "collegeName") return;
                    let val = row[k];
                    if (val === null || val === undefined) {
                        val = '-';
                    } else if (k === "dateEntry" && val) {
                        val = new Date(val).toLocaleDateString('en-IN');
                    }
                    rows += `<td>${val}</td>`;
                });
                rows += "</tr>";
            });

            body.innerHTML = rows;
        }

        // ================= PAGINATION =================
        function renderPagination() {

            let html = "";

            if (currentPage > 1) {
                html += `<button class="btn btn-sm btn-primary"
                onclick="loadReport(${currentPage - 1})">Prev</button>`;
            }

            html += `<span class="px-3">Page ${currentPage} of ${totalPages}</span>`;

            if (currentPage < totalPages) {
                html += `<button class="btn btn-sm btn-primary"
                onclick="loadReport(${currentPage + 1})">Next</button>`;
            }

            document.getElementById("pagination").innerHTML = html;
        }

        // ================= EXPORT =================
        function exportExcel() {

            const collegeName = document.getElementById("collegeName").value;

            if (!collegeName) {
                Swal.fire({ icon: 'warning', title: 'College Required' });
                return;
            }

            if (allBooks.length === 0) {
                Swal.fire({ icon: 'warning', title: 'No Data', text: 'No records to export.' });
                return;
            }

            let csvContent = "data:text/csv;charset=utf-8,";
            if (allBooks.length > 0) {
                const keys = Object.keys(allBooks[0]).filter(k => k !== "collegeName");
                csvContent += keys.join(",") + "\n";

                allBooks.forEach(b => {
                    const row = keys.map(k => {
                        let val = b[k];
                        if (val === null || val === undefined) return "";
                        return `"${String(val).replace(/"/g, '""')}"`;
                    }).join(",");
                    csvContent += row + "\n";
                });
            }

            const encodedUri = encodeURI(csvContent);
            const a = document.createElement("a");
            a.href = encodedUri;
            a.download = `UnissuedBooks_${collegeName}_${new Date().toISOString().slice(0, 10)}.csv`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
        }

    </script>
}
