@using Microsoft.AspNetCore.Http
@using Newtonsoft.Json
@inject IHttpContextAccessor HttpContextAccessor
@{
    ViewData["Title"] = "Student Report";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Read allowed colleges list from session
    var collegesJson = Context.Session.GetString("Colleges");
    List<string> allowedColleges = new();
    if (!string.IsNullOrEmpty(collegesJson))
    {
        allowedColleges = JsonConvert.DeserializeObject<List<string>>(collegesJson) ?? new List<string>();
    }
}
<!-- Print Header -->
<div class="d-none d-print-block print-header" id="printReportHeader">

    <div class="text-center">

        <h2 id="printCollegeName">
            College Name
        </h2>

        <p id="printAddress1"></p>
        <p id="printAddress2"></p>


        <h3>
            Student Details Report
        </h3>


        <div class="print-info">

            <span>
                Generated :
                @DateTime.Now.ToString("dd-MMM-yyyy hh:mm tt")
            </span>


            <span id="printRecordCount">
                0 Records
            </span>

        </div>

    </div>

</div>

<div class="fade-in">
    <!-- Page Header -->
    <div class="page-header mt-2 mb-4">
        <div>
            <h2 class="fw-bold mb-1">
                <i class="fas fa-file-invoice text-primary me-2"></i>Student Details
            </h2>
            <p class="text-muted">Generate and view detailed student admission registers filtered by institution, course, and batch.</p>
        </div>
        <div class="d-flex gap-2 w-100-mobile">
            <button class="btn btn-modern btn-secondary-modern btn-auto-width" id="btnPrint" disabled style="background: linear-gradient(135deg, #3b82f6 0%, #1d4ed8 100%); color: white; box-shadow: 0 4px 14px rgba(59, 130, 246, 0.3);">
                <i class="fas fa-print me-2"></i> Print Report
            </button>
            <button class="btn btn-modern btn-success-modern btn-auto-width text-white" id="btnExport" style="background: linear-gradient(135deg, var(--success) 0%, #15803d 100%); box-shadow: 0 4px 14px rgba(34, 197, 94, 0.3);" disabled>
                <i class="fas fa-file-excel me-2"></i> Export Excel
            </button>
        </div>
    </div>

    <!-- Filters Panel -->
    <div class="modern-card mb-4 glass border-0">
        <div class="row g-3 align-items-end">
            <!-- College Selector -->
            <div class="col-lg-4 col-md-6">
                <label class="form-label small fw-bold text-muted mb-2">College</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-top-left-radius: var(--radius-md); border-bottom-left-radius: var(--radius-md); border-color: var(--border-color);">
                        <i class="fas fa-university text-muted"></i>
                    </span>
                    <select id="ddlCollege" class="form-input-modern" style="border-top-left-radius:0; border-bottom-left-radius:0;">
                        <option value="">-- Loading Colleges... --</option>
                    </select>
                </div>
            </div>

            <!-- Course Selector -->
            <div class="col-lg-3 col-md-6">
                <label class="form-label small fw-bold text-muted mb-2">Course</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-top-left-radius: var(--radius-md); border-bottom-left-radius: var(--radius-md); border-color: var(--border-color);">
                        <i class="fas fa-graduation-cap text-muted"></i>
                    </span>
                    <select id="ddlCourse" class="form-input-modern" style="border-top-left-radius:0; border-bottom-left-radius:0;" disabled>
                        <option value="Select">-- Select College First --</option>
                    </select>
                </div>
            </div>

            <!-- Batch Selector -->
            <div class="col-lg-3 col-md-6">
                <label class="form-label small fw-bold text-muted mb-2">Batch</label>
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0" style="border-top-left-radius: var(--radius-md); border-bottom-left-radius: var(--radius-md); border-color: var(--border-color);">
                        <i class="far fa-calendar-alt text-muted"></i>
                    </span>
                    <select id="ddlBatch" class="form-input-modern" style="border-top-left-radius:0; border-bottom-left-radius:0;" disabled>
                        <option value="Select">-- Select Course First --</option>
                    </select>
                </div>
            </div>

            <!-- Search Action Button -->
            <div class="col-lg-2 col-md-12">
                <button class="btn btn-modern btn-primary-modern w-100 py-2 text-white" id="btnSearch" disabled>
                    <i class="fas fa-search me-2"></i> Search
                </button>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="modern-card shadow-sm p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="fw-bold mb-0 text-main" id="resultsTitle">Student Report</h5>
                    <span class="badge badge-modern badge-modern-primary" id="recordCountDisplay">0 Records Found</span>
                </div>

                <!-- Desktop/Tablet Table View -->
                <div class="table-responsive-modern d-none d-md-block" id="desktopView">
                    <table class="table custom-table mb-0">
                        <thead>
                            <tr>
                                <th class="ps-4">ID No</th>
                                <th>Student Name</th>
                                <th>Course</th>
                                <th>Batch</th>
                                <th>Father's Name</th>
                                <th>Permanent Address</th>
                                <th>Phone No</th>
                                <th>Student Mobile</th>
                                <th>Father Mobile</th>
                                <th class="pe-4">Mother Mobile</th>
                            </tr>
                        </thead>
                        <tbody id="tableBody">
                            <tr>
                                <td colspan="7" class="text-center py-5 text-muted">
                                    <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                                    <p class="mb-0">Enter search criteria to search students.</p>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Mobile Card View -->
                <div class="d-block d-md-none" id="mobileView">
                    <div id="mobileCardsContainer">
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-search fa-3x mb-3 opacity-25"></i>
                            <p class="mb-0">Enter search criteria to search students.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div id="printTableWrapper" style="display:none;">

    <table class="print-custom-table">

        <thead>
            <tr>
                <th>ID No</th>
                <th>Student Name</th>
                <th>Course</th>
                <th>Batch</th>
                <th>Father Name</th>
                <th>Address</th>
                <th>Student Mobile</th>
                <th>Father Mobile</th>
                <th>Mother Mobile</th>
            </tr>
        </thead>


        <tbody id="printTableBody">
        </tbody>

    </table>

</div>
<div class="d-none d-print-block print-footer">

    <span>
        Library Management System
    </span>

    <span>
        Page <span class="pageNumber"></span>
    </span>

</div>
<style>

    @@media print {


        @@page {
            size: A4 portrait;
            margin: 12mm;
        }


        body {
            background: white !important;
            font-family: Arial, sans-serif;
        }



        .sidebar,
        .top-navbar,
        .page-header,
        .modern-card,
        .btn,
        footer {
            display: none !important;
        }



        #printReportHeader {
            display: block !important;
        }



        .print-header h2 {
            font-size: 26px;
            margin-bottom: 5px;
        }



        .print-header p {
            margin: 2px;
            font-size: 14px;
        }



        .print-header h3 {
            margin-top: 15px;
            font-size: 20px;
            border-bottom: 2px solid #000;
            padding-bottom: 5px;
        }



        .print-info {
            display: flex;
            justify-content: space-between;
            font-size: 13px;
            margin-top: 10px;
            border-bottom: 1px solid #000;
            padding-bottom: 5px;
        }



        #printTableWrapper {
            display: block !important;
        }



        .print-custom-table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 15px;
            font-size: 11px;
        }



            .print-custom-table th {
                background: #eee !important;
                color: #000;
                font-weight: bold;
                font-size:13px;
            }



            .print-custom-table th,
            .print-custom-table td {
                border: 1px solid #000;
                padding: 5px;
                text-align: left;
            }
        /* Page Break Control */

        tr {
            page-break-inside: avoid;
        }



        thead {
            display: table-header-group;
        }



        tfoot {
            display: table-footer-group;
        }
    }
    @@media print {


    .print-footer{
    position:fixed;
    bottom:0;

width:100%;

font-size:11px;

display:flex;
justify-content:space-between;

border-top:1px solid #999;

padding-top:5px;

}


}
</style>

@section Scripts {
    <script>
              const allowedColleges = @Html.Raw(JsonConvert.SerializeObject(allowedColleges));

        let state = {
            students: [],
            header: {
                collegeName:"",
                address1:"",
                address2:"",
                totalRecords:0
            }
        };
        $(document).ready(async function () {
            await loadColleges();

            // College Change Handler
            $('#ddlCollege').change(async function () {
                const college = getSelectedCollege();
                resetCourseDropdown();
                resetBatchDropdown();
                disableSearchButton();

                if (!college) return;

                try {
                    showLoader();
                    const response = await fetch(`/StudentReport/Courses?college=${encodeURIComponent(college)}`);
                    Swal.close();

                    if (!response.ok) throw new Error("Failed to load courses");

                    const courses = await response.json();
                    const $ddl = $('#ddlCourse');
                    $ddl.empty();
                    $ddl.append('<option value="Select">-- All Courses --</option>');
                    
                    courses.forEach(c => {
                        $ddl.append(`<option value="${encodeURIComponent(c.course)}">${c.course}</option>`);
                    });
                    $ddl.prop('disabled', false);
                    $('#btnSearch').prop('disabled', false); // Enable search immediately for the college
                } catch (err) {
                    Swal.close();
                    console.error("Courses loading failed:", err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to retrieve courses for the selected college.'
                    });
                }
            });

            // Course Change Handler
            $('#ddlCourse').change(async function () {
                const college = getSelectedCollege();
                const course = getSelectedCourse();
                resetBatchDropdown();

                if (!college || !course || course === 'Select') {
                    return;
                }

                try {
                    showLoader();
                    const response = await fetch(`/StudentReport/Batch?college=${encodeURIComponent(college)}&course=${encodeURIComponent(course)}`);
                    Swal.close();

                    if (!response.ok) throw new Error("Failed to load batches");

                    const batches = await response.json();
                    const $ddl = $('#ddlBatch');
                    $ddl.empty();
                    $ddl.append('<option value="Select">-- All Batches --</option>');
                    
                    batches.forEach(b => {
                        $ddl.append(`<option value="${encodeURIComponent(b.batch)}">${b.batch}</option>`);
                    });
                    $ddl.prop('disabled', false);
                } catch (err) {
                    Swal.close();
                    console.error("Batches loading failed:", err);
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: 'Failed to retrieve batches for the selected course.'
                    });
                }
            });

            // Search Trigger
            $('#btnSearch').click(async function () {
                await executeSearch();
            });

             $("#btnPrint").click(function () {
               printReport();
             });

            // Export Excel Trigger (CSV Format)
            $('#btnExport').click(function () {
                exportToExcel();
            });
        });

        // ================= GET SELECTIONS =================
        function getSelectedCollege() {
            const val = $('#ddlCollege').val();
            return val ? decodeURIComponent(val) : "";
        }

        function getSelectedCourse() {
            const val = $('#ddlCourse').val();
            return val ? decodeURIComponent(val) : "Select";
        }

        function getSelectedBatch() {
            const val = $('#ddlBatch').val();
            return val ? decodeURIComponent(val) : "Select";
        }

        // ================= RESET STATE HELPERS =================
        function resetCourseDropdown() {
            const $ddl = $('#ddlCourse');
            $ddl.empty().append('<option value="Select">-- Select College First --</option>').prop('disabled', true);
        }

        function resetBatchDropdown() {
            const $ddl = $('#ddlBatch');
            $ddl.empty().append('<option value="Select">-- Select Course First --</option>').prop('disabled', true);
        }

        function disableSearchButton() {
            $('#btnSearch').prop('disabled', true);
        }

        // ================= DYNAMIC COLLEGE LOAD =================
        async function loadColleges() {
            try {
                const response = await fetch('/StudentReport/Colleges');
                if (!response.ok) throw new Error("Failed to fetch colleges");
                
                const allColleges = await response.json();
                
                // Client-side Session College Access Filter
                let filtered = allColleges;
                if (allowedColleges && allowedColleges.length > 0) {
                    filtered = allColleges.filter(c => 
                        allowedColleges.some(ac => ac.toLowerCase() === c.collegeName.toLowerCase())
                    );
                } else {
                    // No colleges assigned in login session
                    filtered = [];
                }

                const $ddl = $('#ddlCollege');
                $ddl.empty();

                if (filtered.length === 0) {
                    $ddl.append('<option value="">-- No Colleges Authorized --</option>');
                    disableSearchButton();
                    return;
                }

                $ddl.append('<option value="">-- Select College --</option>');
                filtered.forEach(c => {
                    $ddl.append(`<option value="${encodeURIComponent(c.collegeName)}">${c.collegeName}</option>`);
                });

                // Auto-select if user is authorized for exactly one college
                // if (filtered.length === 1) {
                //     $ddl.val(encodeURIComponent(filtered[0].collegeName)).trigger('change');
                // }
            } catch (err) {
                console.error("Colleges loading failed:", err);
                Swal.fire({
                    icon: 'error',
                    title: 'Retrieval Failed',
                    text: 'Failed to retrieve college profiles list from server.'
                });
            }
        }

        // ================= SEARCH IMPLEMENTATION =================
        async function executeSearch() {
            const college = getSelectedCollege();
            const course = getSelectedCourse();
            const batch = getSelectedBatch();

            if (!college) {
                Swal.fire({
                    icon: 'warning',
                    title: 'College Required',
                    text: 'Please select a college name to perform search.'
                });
                return;
            }

            showLoader();
            try {
                const response = await $.ajax({
                    url: '/StudentReport/Search',
                    type: 'POST',
                    contentType: 'application/json',
                    data: JSON.stringify({
                        CollegeName: college,
                        Course: course,
                        Batch: batch
                    })
                });

        Swal.close();


        state.students = response.studentList || [];


        state.header = {

            collegeName: response.collegeName || "",

            address1: response.address1 || "",

            address2: response.address2 || "",

            totalRecords: response.totalRecords || 0

        };


        renderTable();
                
            } catch (err) {
                Swal.close();
                console.error("Search request failed:", err);
                Swal.fire({
                    icon: 'error',
                    title: 'Search Failed',
                    text: 'A network or server error occurred while retrieving report results.'
                });
            }
        }

        // ================= TABLE RENDER =================
            function renderTable(){


        let tbody=$("#tableBody");

        tbody.empty();


        let students=state.students;


        $("#recordCountDisplay")
        .text(`${students.length} Records Found`);



        if(students.length===0){


        tbody.html(`

        <tr>

        <td colspan="10"
        class="text-center py-5">

        No Records Found

        </td>

        </tr>

        `);


        $("#btnPrint,#btnExport")
        .prop("disabled",true);


        return;

        }




        students.forEach(s=>{


        tbody.append(`

        <tr>

        <td>${s.idNo ?? '-'}</td>

        <td>${s.studentName ?? '-'}</td>

        <td>${s.course ?? '-'}</td>

        <td>${s.batch ?? '-'}</td>

        <td>${s.fatherName ?? '-'}</td>

        <td>${s.permanentAddress ?? '-'}</td>

        <td>${s.phoneNo ?? '-'}</td>

        <td>${s.studentMobileNo ?? '-'}</td>

        <td>${s.fatherMobileNo ?? '-'}</td>

        <td>${s.motherMobileNo ?? '-'}</td>


        </tr>


        `);


        });



        $("#btnPrint,#btnExport")
        .prop("disabled",false);


        }


        // ================= EXPORT EXCEL (CSV DOWNLOAD) =================
        function exportToExcel() {

            if(state.students.length===0)
                return;


            let csvContent = "\uFEFF";


            const headers=[
                "ID No",
                "Student Name",
                "Course",
                "Batch",
                "Father Name",
                "Permanent Address",
                "Phone No",
                "Student Mobile",
                "Father Mobile",
                "Mother Mobile"
            ];


            csvContent += headers.map(x=>`"${x}"`).join(",")+"\r\n";


            state.students.forEach(row=>{

                let values=[
                    row.idNo,
                    row.studentName,
                    row.course,
                    row.batch,
                    row.fatherName,
                    row.permanentAddress,
                    row.phoneNo,
                    row.studentMobileNo,
                    row.fatherMobileNo,
                    row.motherMobileNo
                ];


                csvContent += values
                .map(v=>`"${(v??"").toString().replace(/"/g,'""')}"`)
                .join(",")+"\r\n";

            });



            let blob=new Blob(
                [csvContent],
                {
                    type:"text/csv;charset=utf-8;"
                }
            );


            let url=URL.createObjectURL(blob);


            let a=document.createElement("a");

            a.href=url;

            a.download=
            `StudentReport_${getSelectedCollege()}.csv`;


            a.click();


            URL.revokeObjectURL(url);

        }
        function printReport(){


        if(state.students.length===0)
        return;



        $("#printCollegeName")
        .text(state.header.collegeName);



        $("#printAddress1")
        .text(state.header.address1);



        $("#printAddress2")
        .text(state.header.address2);



        $("#printRecordCount")
        .text(
        `${state.header.totalRecords} Records Found`
        );



        let tbody=$("#printTableBody");


        tbody.empty();



        state.students.forEach(s=>{


        tbody.append(`

        <tr>

        <td>${s.idNo ?? ''}</td>

        <td>${s.studentName ?? ''}</td>

        <td>${s.course ?? ''}</td>

        <td>${s.batch ?? ''}</td>

        <td>${s.fatherName ?? ''}</td>

        <td>${s.permanentAddress ?? ''}</td>

        <td>${s.studentMobileNo ?? ''}</td>

        <td>${s.fatherMobileNo ?? ''}</td>

        <td>${s.motherMobileNo ?? ''}</td>

        </tr>

        `);


        });



        window.print();


        }
    
                    
        // ================= DYNAMIC SPINNER =================
        function showLoader() {
            Swal.fire({
                title: 'Loading Data...',
                text: 'Please Wait',
                allowOutsideClick: false,
                showConfirmButton: false,
                didOpen: () => {
                    Swal.showLoading();
                }
            });
        }
    </script>
}
