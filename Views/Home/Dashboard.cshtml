@model lib.DtoModel.DashboardDto.DashboardStatsDto
@using Microsoft.AspNetCore.Http
@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";

    // Helper calculation for ratios
    double issueRatio = Model.TotalBooks > 0 ? ((double)Model.IssuedBooks / Model.TotalBooks) * 100 : 0;
    double availableRatio = Model.TotalBooks > 0 ? ((double)Model.AvailableBooks / Model.TotalBooks) * 100 : 0;
    double overdueRatio = Model.IssuedBooks > 0 ? ((double)Model.OverdueBooks / Model.IssuedBooks) * 100 : 0;
}

<div class="fade-in">
    <!-- Dashboard Header -->
    <div class="page-header mt-2 mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3">
        <div>
            <h2 class="fw-bold mb-1"><i class="fas fa-tachometer-alt me-2 text-primary"></i>Library Control Hub</h2>
            <p class="text-muted">Welcome back, @Context.Session.GetString("UserName")! Here is the real-time library catalog status overview.</p>
        </div>
        <div class="d-flex gap-2 w-100-mobile">
            <a href="/IssueBook" class="btn btn-modern btn-primary-modern btn-auto-width text-white text-decoration-none shadow-sm">
                <i class="fas fa-plus me-2"></i> Issue Book
            </a>
            <a href="/ReturnBook" class="btn btn-modern btn-danger-modern btn-auto-width text-white text-decoration-none shadow-sm">
                <i class="fas fa-undo-alt me-2"></i> Return Book
            </a>
        </div>
    </div>

    <!-- Global Quick Search Bar -->
    <div class="row mb-4">
        <div class="col-12 position-relative">
            <div class="input-group input-group-lg shadow-sm border rounded overflow-hidden">
                <span class="input-group-text bg-white border-0 text-muted">
                    <i class="fas fa-search"></i>
                </span>
                <input type="text" id="globalSearchInput" class="form-control border-0 fs-5 py-3" placeholder="Quick Search: Enter book title, author, accession no, or student name/ID..." autocomplete="off" oninput="onGlobalSearch(this.value)" />
                <button type="button" class="btn btn-light border-0 px-3" onclick="clearQuickSearch()" title="Clear">
                    <i class="fas fa-times text-muted"></i>
                </button>
            </div>
            <!-- Dynamic Suggestions Dropdown -->
            <div id="searchSuggestions" class="list-group position-absolute w-100 mt-1 d-none shadow-lg border rounded bg-white" style="z-index: 1050; max-height: 320px; overflow-y: auto; left: 0; right: 0;">
                <div class="list-group-item bg-light text-muted small py-2 fw-semibold" style="border-top: none;">Suggestions & Matches</div>
                <div id="suggestionsList"></div>
            </div>
        </div>
    </div>

    <!-- 8 Premium SaaS KPI Cards -->
    <div class="row g-3 g-md-4 mb-4">
        <!-- 1. Total Books -->
        <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="stat-card card-total-books" style="background: linear-gradient(135deg, #eef2f7 0%, #dce4ec 100%); border-left: 5px solid #4F81BD;">
                <div class="stat-header">
                    <div>
                        <div class="stat-title fw-bold text-uppercase small text-muted">Total Books</div>
                        <div class="stat-value text-main font-bold fs-3">@Model.TotalBooks.ToString("N0")</div>
                    </div>
                    <div class="stat-icon-wrapper" style="background-color: rgba(79, 129, 189, 0.15); color: #4F81BD;">
                        <i class="fas fa-book fa-lg"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="stat-progress">
                        <div class="stat-progress-bar" style="width: 100%; background-color: #4F81BD;"></div>
                    </div>
                    <div class="stat-footer d-flex justify-content-between mt-2 small text-muted">
                        <span>Total Cataloged</span>
                        <span class="fw-semibold">100%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. Issued Books -->
        <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="stat-card card-issued-books" style="background: linear-gradient(135deg, #eef7ee 0%, #dcecdb 100%); border-left: 5px solid #5cb85c;">
                <div class="stat-header">
                    <div>
                        <div class="stat-title fw-bold text-uppercase small text-muted">Issued Books</div>
                        <div class="stat-value text-success font-bold fs-3">@Model.IssuedBooks.ToString("N0")</div>
                    </div>
                    <div class="stat-icon-wrapper" style="background-color: rgba(92, 184, 92, 0.15); color: #5cb85c;">
                        <i class="fas fa-exchange-alt fa-lg"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="stat-progress">
                        <div class="stat-progress-bar" style="width: @(issueRatio)%; background-color: #5cb85c;"></div>
                    </div>
                    <div class="stat-footer d-flex justify-content-between mt-2 small text-muted">
                        <span>Active Circulation</span>
                        <span class="fw-semibold">@issueRatio.ToString("F1")%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Available Books -->
        <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="stat-card card-returned-books" style="background: linear-gradient(135deg, #eef9f9 0%, #dcecec 100%); border-left: 5px solid #5bc0de;">
                <div class="stat-header">
                    <div>
                        <div class="stat-title fw-bold text-uppercase small text-muted">Available Books</div>
                        <div class="stat-value text-info font-bold fs-3">@Model.AvailableBooks.ToString("N0")</div>
                    </div>
                    <div class="stat-icon-wrapper" style="background-color: rgba(91, 192, 222, 0.15); color: #5bc0de;">
                        <i class="fas fa-check-circle fa-lg"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="stat-progress">
                        <div class="stat-progress-bar" style="width: @(availableRatio)%; background-color: #5bc0de;"></div>
                    </div>
                    <div class="stat-footer d-flex justify-content-between mt-2 small text-muted">
                        <span>On Shelves</span>
                        <span class="fw-semibold">@availableRatio.ToString("F1")%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 4. Overdue Books -->
        <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="stat-card card-overdue-books" style="background: linear-gradient(135deg, #fdf4f4 0%, #fae6e6 100%); border-left: 5px solid #d9534f;">
                <div class="stat-header">
                    <div>
                        <div class="stat-title fw-bold text-uppercase small text-muted">Overdue Books</div>
                        <div class="stat-value text-danger font-bold fs-3">@Model.OverdueBooks.ToString("N0")</div>
                    </div>
                    <div class="stat-icon-wrapper" style="background-color: rgba(217, 83, 79, 0.15); color: #d9534f;">
                        <i class="fas fa-clock fa-lg"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="stat-progress">
                        <div class="stat-progress-bar" style="width: @(overdueRatio)%; background-color: #d9534f;"></div>
                    </div>
                    <div class="stat-footer d-flex justify-content-between mt-2 small text-muted">
                        <span>Overdue Ratio</span>
                        <span class="fw-semibold">@overdueRatio.ToString("F1")%</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 5. Total Students -->
        <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="stat-card card-total-students" style="background: linear-gradient(135deg, #f4f6fb 0%, #e6eaf3 100%); border-left: 5px solid #6f42c1;">
                <div class="stat-header">
                    <div>
                        <div class="stat-title fw-bold text-uppercase small text-muted">Registered Students</div>
                        <div class="stat-value font-bold fs-3" style="color: #6f42c1;">@Model.TotalStudents.ToString("N0")</div>
                    </div>
                    <div class="stat-icon-wrapper" style="background-color: rgba(111, 66, 193, 0.15); color: #6f42c1;">
                        <i class="fas fa-user-graduate fa-lg"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="stat-progress">
                        <div class="stat-progress-bar" style="width: 100%; background-color: #6f42c1;"></div>
                    </div>
                    <div class="stat-footer d-flex justify-content-between mt-2 small text-muted">
                        <span>Admissions Registered</span>
                        <span class="fw-semibold">Active</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 6. Faculty & Staff -->
        <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="stat-card card-active-users" style="background: linear-gradient(135deg, #fcf6ff 0%, #f6e6ff 100%); border-left: 5px solid #a020f0;">
                <div class="stat-header">
                    <div>
                        <div class="stat-title fw-bold text-uppercase small text-muted">Faculty & Staff</div>
                        <div class="stat-value font-bold fs-3" style="color: #a020f0;">@Model.TotalStaff.ToString("N0")</div>
                    </div>
                    <div class="stat-icon-wrapper" style="background-color: rgba(160, 32, 240, 0.15); color: #a020f0;">
                        <i class="fas fa-users fa-lg"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="stat-progress">
                        <div class="stat-progress-bar" style="width: 100%; background-color: #a020f0;"></div>
                    </div>
                    <div class="stat-footer d-flex justify-content-between mt-2 small text-muted">
                        <span>Employees & Faculty</span>
                        <span class="fw-semibold">Active</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 7. Book Categories -->
        <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="stat-card card-renewed-books" style="background: linear-gradient(135deg, #fffaf4 0%, #ffeecb 100%); border-left: 5px solid #f0ad4e;">
                <div class="stat-header">
                    <div>
                        <div class="stat-title fw-bold text-uppercase small text-muted">Categories</div>
                        <div class="stat-value text-warning font-bold fs-3">@Model.TotalCategories.ToString("N0")</div>
                    </div>
                    <div class="stat-icon-wrapper" style="background-color: rgba(240, 173, 78, 0.15); color: #f0ad4e;">
                        <i class="fas fa-tags fa-lg"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="stat-progress">
                        <div class="stat-progress-bar" style="width: 100%; background-color: #f0ad4e;"></div>
                    </div>
                    <div class="stat-footer d-flex justify-content-between mt-2 small text-muted">
                        <span>Subject Disciplines</span>
                        <span class="fw-semibold">Categorized</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- 8. Book Publishers -->
        <div class="col-sm-6 col-md-4 col-xl-3">
            <div class="stat-card card-pending-returns" style="background: linear-gradient(135deg, #fff6fa 0%, #ffe6f3 100%); border-left: 5px solid #ff1493;">
                <div class="stat-header">
                    <div>
                        <div class="stat-title fw-bold text-uppercase small text-muted">Publishers</div>
                        <div class="stat-value font-bold fs-3" style="color: #ff1493;">@Model.TotalPublishers.ToString("N0")</div>
                    </div>
                    <div class="stat-icon-wrapper" style="background-color: rgba(255, 20, 147, 0.15); color: #ff1493;">
                        <i class="fas fa-university fa-lg"></i>
                    </div>
                </div>
                <div class="mt-3">
                    <div class="stat-progress">
                        <div class="stat-progress-bar" style="width: 100%; background-color: #ff1493;"></div>
                    </div>
                    <div class="stat-footer d-flex justify-content-between mt-2 small text-muted">
                        <span>Publishing Houses</span>
                        <span class="fw-semibold">Registered</span>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Charts and Activity Section -->
    <div class="row g-4">
        <!-- Borrowing Trends Chart Card -->
        <div class="col-lg-8">
            <div class="modern-card shadow-sm p-4 h-100">
                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div>
                        <h5 class="fw-bold mb-0 text-main">Borrowing Trends</h5>
                        <p class="text-muted small mb-0">Daily summary of book issuances for the last 7 days</p>
                    </div>
                    <div class="badge bg-light text-dark border px-3 py-2 small">
                        <i class="far fa-calendar-alt text-primary me-1"></i> Last 7 Days
                    </div>
                </div>
                
                <div class="p-2" style="position: relative; height: 320px; width: 100%;">
                    <canvas id="borrowingChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Recent Activities Card -->
        <div class="col-lg-4">
            <div class="modern-card shadow-sm p-4 h-100">
                <h5 class="fw-bold mb-4 text-main"><i class="fas fa-history me-2 text-primary"></i>Recent Activities</h5>
                <div class="activity-timeline">
                    @if (Model.RecentActivities != null && Model.RecentActivities.Any())
                    {
                        foreach (var act in Model.RecentActivities)
                        {
                            <div class="activity-item pb-3 mb-3 border-bottom position-relative">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <span class="fw-bold text-main fs-6">@act.Title</span>
                                    <span class="badge bg-light text-muted small" style="font-size: 0.72rem;">@act.TimeAgo</span>
                                </div>
                                <p class="text-muted small mb-2">@act.Details</p>
                                <span class="badge px-2 py-1 small fw-semibold" style="font-size: 0.68rem; background-color: rgba(@(act.Status == "success" ? "40, 167, 69" : act.Status == "danger" ? "220, 53, 69" : act.Status == "warning" ? "255, 193, 7" : "23, 162, 184"), 0.15); color: @(act.Status == "success" ? "#28a745" : act.Status == "danger" ? "#dc3545" : act.Status == "warning" ? "#ffc107" : "#17a2b8");">
                                    <i class="fas @(act.Status == "success" ? "fa-check-circle" : act.Status == "danger" ? "fa-exclamation-circle" : "fa-info-circle") me-1"></i> @act.Status
                                </span>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-history fa-3x mb-3 opacity-25"></i>
                            <p class="mb-0">No recent activity detected.</p>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let searchTimeout = null;

        function onGlobalSearch(val) {
            clearTimeout(searchTimeout);
            const query = val.trim();
            const dropdown = document.getElementById("searchSuggestions");
            const list = document.getElementById("suggestionsList");

            if (query.length < 2) {
                dropdown.classList.add("d-none");
                return;
            }

            searchTimeout = setTimeout(async () => {
                try {
                    const response = await fetch('/api/Dashboard/QuickSearch?query=' + encodeURIComponent(query));
                    if (!response.ok) throw new Error();

                    const results = await response.json();
                    list.innerHTML = "";

                    if (results.length === 0) {
                        list.innerHTML = '<div class="list-group-item text-muted py-3 text-center"><i class="fas fa-info-circle me-1"></i>No matching books or students found.</div>';
                        dropdown.classList.remove("d-none");
                        return;
                    }

                    results.forEach(item => {
                        const btn = document.createElement("a");
                        btn.className = "list-group-item list-group-item-action d-flex justify-content-between align-items-center py-3";
                        
                        if (item.Type === "Book") {
                            btn.href = '/SearchAccession?accessionNo=' + encodeURIComponent(item.Id);
                        } else {
                            btn.href = '/PersonSearch?id=' + encodeURIComponent(item.Id);
                        }

                        let badgeColor = item.Type === "Book" ? "bg-primary" : "bg-success";
                        let icon = item.Type === "Book" ? "fa-book" : "fa-user-graduate";

                        btn.innerHTML = `
                            <div class="d-flex align-items-center">
                                <div class="me-3 text-muted" style="width: 24px; text-align: center;"><i class="fas ${icon} fa-lg"></i></div>
                                <div>
                                    <h6 class="mb-0 fw-bold text-main text-start">${escapeHtml(item.Title)}</h6>
                                    <small class="text-muted text-start d-block">${escapeHtml(item.Subtitle)}</small>
                                </div>
                            </div>
                            <span class="badge ${badgeColor} text-uppercase px-2 py-1 small">${item.Type}</span>
                        `;
                        list.appendChild(btn);
                    });

                    dropdown.classList.remove("d-none");
                } catch (e) {
                    console.error("Search failed", e);
                }
            }, 250);
        }

        // Add pre-fill listener for accession parameter in SearchAccession view
        document.addEventListener("DOMContentLoaded", () => {
            const urlParams = new URLSearchParams(window.location.search);
            const accessionParam = urlParams.get('accessionNo');
            const accInput = document.getElementById("accessionNoInput");
            if (accessionParam && accInput) {
                accInput.value = accessionParam;
            }
        });

        function clearQuickSearch() {
            document.getElementById("globalSearchInput").value = "";
            document.getElementById("searchSuggestions").classList.add("d-none");
        }

        function escapeHtml(text) {
            return text
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        // Close suggestions dropdown when clicking outside
        document.addEventListener("click", (e) => {
            const dropdown = document.getElementById("searchSuggestions");
            const input = document.getElementById("globalSearchInput");
            if (dropdown && input && e.target !== dropdown && e.target !== input && !dropdown.contains(e.target)) {
                dropdown.classList.add("d-none");
            }
        });

        document.addEventListener("DOMContentLoaded", () => {
            // Render borrowing trends chart using Chart.js
            const ctx = document.getElementById('borrowingChart').getContext('2d');
            
            // Serialize model trends list safely
            const trends = @Html.Raw(Newtonsoft.Json.JsonConvert.SerializeObject(Model.BorrowingTrends));
            
            const labels = trends.map(t => t.Date);
            const dataCounts = trends.map(t => t.Count);

            // Chart area filling gradient color
            const fillGradient = ctx.createLinearGradient(0, 0, 0, 300);
            fillGradient.addColorStop(0, 'rgba(79, 129, 189, 0.4)');
            fillGradient.addColorStop(1, 'rgba(79, 129, 189, 0.0)');

            new Chart(ctx, {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Books Issued',
                        data: dataCounts,
                        borderColor: '#4F81BD',
                        borderWidth: 3,
                        backgroundColor: fillGradient,
                        fill: true,
                        tension: 0.4, // Curved lines
                        pointBackgroundColor: '#4F81BD',
                        pointBorderColor: '#ffffff',
                        pointBorderWidth: 2,
                        pointRadius: 6,
                        pointHoverRadius: 8
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: {
                            display: false
                        },
                        tooltip: {
                            padding: 12,
                            backgroundColor: 'rgba(0,0,0,0.85)',
                            titleFont: { size: 14, weight: 'bold' },
                            bodyFont: { size: 13 },
                            callbacks: {
                                label: function(context) {
                                    return ` ${context.parsed.y} books issued`;
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(0, 0, 0, 0.05)',
                                drawBorder: false
                            },
                            ticks: {
                                font: { size: 11, family: 'sans-serif' },
                                color: '#6c757d',
                                precision: 0
                            }
                        },
                        x: {
                            grid: {
                                display: false
                            },
                            ticks: {
                                font: { size: 11, family: 'sans-serif' },
                                color: '#6c757d'
                            }
                        }
                    }
                }
            });
        });
    </script>
}